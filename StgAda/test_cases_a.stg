>>

JoinItems(sPart, soNestedPart) ::= <<
<sPart>
<if(soNestedPart)>
if result.Success  then
    <soNestedPart>
end if;

<endif>
>>


Codec_declare_EncInDecOut_variable(sPrmName, sType, sPrmValue) ::= <<
enc_<sPrmName> : constant <sType> := <sPrmValue>;
dec_<sPrmName> : <sType>;
>>

