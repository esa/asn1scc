group spark_automatic_test_cases;

rtlModuleName() ::= "adaasn1rtl"


PrintAutomaticTestCasesSpecFile(sModNameUpperCase, sModName, arrsIncludedModules, arrsTestFunctions) ::= <<
pragma Style_Checks (Off);
--  Code automatically generated by asn1scc tool
pragma Warnings (Off, "unit ""<rtlModuleName()>"" is not referenced");
with <rtlModuleName()>;
pragma Warnings (Off, "unit ""<rtlModuleName()>"" is not referenced");
--with <sModName>;

<arrsIncludedModules:{inc| 
pragma Warnings (Off, "no entities of ""<inc>"" are referenced");
pragma Warnings (Off, "unit ""<inc>"" is not referenced");
with <inc>;
pragma Warnings (On, "no entities of ""<inc>"" are referenced");
pragma Warnings (On, "unit ""<inc>"" is not referenced");
}; separator="\n">

<if(arrsIncludedModules)>

<endif>
package <sModName>_auto_tcs
is

<arrsTestFunctions; separator="\n\n">

end <sModName>_auto_tcs;
>>
                
PrintCodec_spec(sFuncName, sModName, sTasName, sStar, sVal) ::= <<
function <sFuncName>(<sVal>:<sModName>.<sTasName>; Filename : in String) return <rtlModuleName()>.TEST_CASE_RESULT;
>>


PrintAutomaticTestCasesBodyFile(sModName, sTetscaseSpecFileName, arrsIncludedModules, arrsTasNames, arrsTestFunctions, bXer) ::= <<
pragma Style_Checks (Off);
--  Code automatically generated by asn1scc tool
with Interfaces;
<if(bXer)>pragma Warnings (Off, "unit ""adaasn1rtl.encoding.test_cases_aux"" is not referenced");<\n><endif>with adaasn1rtl.encoding.test_cases_aux;
<if(bXer)>
pragma Warnings (On, "unit ""adaasn1rtl.encoding.test_cases_aux"" is not referenced");
with adaasn1rtl.encoding.xer;

<endif>

pragma Warnings (Off, "use clause for type");
use type Interfaces.Unsigned_8;
use type <rtlModuleName()>.Asn1UInt;
use type <rtlModuleName()>.Asn1Int;
use type <rtlModuleName()>.BIT;
use type <rtlModuleName()>.Asn1ObjectIdentifier;
pragma Warnings (On, "use clause for type");

<arrsIncludedModules:{inc| 
pragma Warnings (Off, "no entities of ""<inc>"" are referenced");
pragma Warnings (Off, "use clause for package ""<inc>"" has no effect");
pragma Warnings (Off, "unit ""<inc>"" is not referenced");
with <inc>; USE <inc>;
pragma Warnings (On, "no entities of ""<inc>"" are referenced");
pragma Warnings (On, "use clause for package ""<inc>"" has no effect");
pragma Warnings (On, "unit ""<inc>"" is not referenced");
}; separator="\n">
<arrsTasNames: {tasName|use type <tasName>;}; separator="\n">
package body <sModName>_auto_tcs 
is 

<arrsTestFunctions; separator="\n\n">

end <sModName>_auto_tcs;
>>







Codec_Encode(sModName, sFuncName, sVal) ::= <<
--  Encode value
<sModName>.<sFuncName>(<sVal>, stream, result);
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_ENCODE, Success => result.Success, ErrorCode => result.ErrorCode);
>>

Codec_Encode_XER(sModName, sFuncName, sVal, sTasName) ::= <<
<Codec_Encode(sModName=sModName, sFuncName=sFuncName, sVal=sVal)>
>>

Codec_Decode(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
--  Decode value
--  at this point stream contains the <sEnc> data
stream.Current_Bit_Pos :=0;
<sModName>.<sFuncName>(decodedPDU, stream, result);
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_DECODE, Success => result.Success, ErrorCode => result.ErrorCode);
>>

Codec_Decode_exact_length(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
--  Decode value ('size deduced' PDU): the decoder derives element counts from
--  the end of the bitstream view (End_Bit_Pos), so the view ends at the encoded
--  length; the buffer keeps the size the decoder's precondition requires
declare
    decStream : adaasn1rtl.encoding.Bitstream := stream;
begin
    decStream.End_Bit_Pos := adaasn1rtl.encoding.BitStream_current_length_in_bytes(stream) * 8;
    decStream.Current_Bit_Pos := 0;
    <sModName>.<sFuncName>_aux(decodedPDU, decStream, result);
end;
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_DECODE, Success => result.Success, ErrorCode => result.ErrorCode);
>>

Codec_Decode_XER(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
--  Decode value
--  at this point stream contains the <sEnc> data
stream.CurrentByte :=1;
<sModName>.<sFuncName>(decodedPDU, stream, result);
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_DECODE, Success => result.Success, ErrorCode => result.ErrorCode);
>>



Codec_validate_output(sModName, sFuncName, sAmber) ::= <<
--  validate decoded data
result := <sModName>.<sFuncName>(decodedPDU);
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_VALIDATE_DECODED, Success => result.Success, ErrorCode => result.ErrorCode);
>>

Codec_compare_input_with_output(sModName, sFuncName, sVal, sAmber) ::= <<
ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_EQUAL, Success => <sModName>.<sFuncName>(<sVal>, decodedPDU), ErrorCode => result.ErrorCode);
>>

/* Decode fault sweep of the automatic tests (coverage step 10): the helper lives in the Ada RTL
   (adaasn1rtl.encoding.test_cases_aux.Decode_Corruption_Sweep); no truncation, see LangGeneric_a.atcDecodeSweep. */
Codec_DecodeSweep_helper(nBudget) ::= <<
>>

Codec_DecodeSweep_adapter(sModName, sFuncName, sDecFuncName, soEncFuncName, sTasName, sAmber, soIsValidFunc) ::= <<
>>

Codec_DecodeSweep(sModName, sFuncName, sDecFuncName, soEncFuncName, sTasName, sEnc, sAmber, sVal, soIsValidFunc, bTruncate, bDeduced, nBudget, soEqualFunc, sInitFunc, nLastOffset, nExtraBytes, arrnCorruptAt) ::= <<
--  Decode corrupted copies of the encoded value
if ret.Success then
    declare
        procedure Sweep_Decode (bs : in out adaasn1rtl.encoding.Bitstream; Res : out <rtlModuleName()>.ASN1_RESULT; Valid : out Boolean) is
        begin
            <sModName>.<sDecFuncName>(decodedPDU, bs, Res);
            Valid := <if(soIsValidFunc)>not Res.Success or else <sModName>.<soIsValidFunc>(decodedPDU).Success<else>True<endif>;
        end Sweep_Decode;<if(arrnCorruptAt)><\n>        type Byte_Offsets is array (Positive range \<\>) of Natural;
        Fragmentation_Header_Bytes : constant Byte_Offsets := (<arrnCorruptAt:{p|<i> => <p>}; separator=", ">);
        Encoded_End : constant Natural := stream.Current_Bit_Pos;<endif>
    begin
<if(bDeduced)>
        --  'size deduced' PDU: the view ends at the encoded length (coverage step 14i)
        stream.End_Bit_Pos := adaasn1rtl.encoding.BitStream_current_length_in_bytes(stream) * 8;<\n><endif>        adaasn1rtl.encoding.test_cases_aux.Decode_Corruption_Sweep(stream, "<sFuncName>", <nBudget>, Sweep_Decode'Access, result);
<if(bDeduced)>
        if result.Success then
            adaasn1rtl.encoding.test_cases_aux.Decode_View_End_Sweep(stream, "<sFuncName>", Sweep_Decode'Access, result);
        end if;
        stream.End_Bit_Pos := stream.Size_In_Bytes * 8;<\n><endif><if(arrnCorruptAt)>
        --  the fragmentation headers of the fixed-size encoding and the byte after each (offsets from 0), deep inside the
        --  value where the positions above do not reach (coverage cycle 15d): set to 16#00#, 16#FF# and with each bit
        --  flipped; the decoder must fail with an error code or return a valid value
        for Offset of Fragmentation_Header_Bytes loop
            for k in 1 .. 10 loop
                exit when not result.Success;
                declare
                    Saved   : constant <rtlModuleName()>.Asn1Byte := stream.Buffer (Offset + 1);
                    Pattern : constant <rtlModuleName()>.Asn1Byte :=
                      (case k is
                          when 1      => 16#00#,
                          when 2      => 16#FF#,
                          when others => Saved xor Interfaces.Shift_Left (1, k - 3));
                    Res     : <rtlModuleName()>.ASN1_RESULT;
                    Valid   : Boolean;
                begin
                    if Pattern /= Saved then
                        stream.Buffer (Offset + 1) := Pattern;
                        Sweep_Decode (stream, Res, Valid);
                        stream.Buffer (Offset + 1) := Saved;
                        if (Res.Success and then not Valid) or else (not Res.Success and then Res.ErrorCode = 0) then
                            result := (Success => False, ErrorCode => 7);
                        end if;
                    end if;
                end;
            end loop;
        end loop;
        stream.Current_Bit_Pos := Encoded_End;<\n><endif>        ret := <rtlModuleName()>.TEST_CASE_RESULT'(Step => <rtlModuleName()>.TC_DECODE_CORRUPTED, Success => result.Success, ErrorCode => result.ErrorCode);
    end;
end if;<if(soEncFuncName)><if(soEqualFunc)><\n>--  Encode / decode the value from bit offsets 1 .. <nLastOffset> (coverage step 15b): encoder and decoder _aux
--  keep the position; the stream holds <nExtraBytes> byte(s) more than the stream above (the type's maximum); the decoder must stop where
--  the encoder stopped; the packages are named from Standard: a module can have the name of a local below (an ASN.1
--  module name can map to any Ada identifier, so no local name is safe), which would hide its package here
if ret.Success then
    declare
        procedure Offset_Encode (bs : in out adaasn1rtl.encoding.Bitstream; Res : out <rtlModuleName()>.ASN1_RESULT) is
        begin
            Standard.<sModName>.<soEncFuncName>_aux(<sVal>, bs, Res);
        end Offset_Encode;
        procedure Offset_Decode (bs : in out adaasn1rtl.encoding.Bitstream; Res : out <rtlModuleName()>.ASN1_RESULT) is
        begin
            decodedPDU := Standard.<sModName>.<sInitFunc>;
            Standard.<sModName>.<sDecFuncName>_aux(decodedPDU, bs, Res);
        end Offset_Decode;
        function Offset_Valid return Boolean is (<if(soIsValidFunc)>Standard.<sModName>.<soIsValidFunc>(decodedPDU).Success<else>True<endif>);
        function Offset_Same return Boolean is (Standard.<sModName>.<soEqualFunc>(<sVal>, decodedPDU));
    begin
        adaasn1rtl.encoding.test_cases_aux.Offset_Round_Trips("<sFuncName>", stream.Size_In_Bytes + <nExtraBytes>, <nLastOffset>, <if(bDeduced)>True<else>False<endif>, Offset_Encode'Access, Offset_Decode'Access, Offset_Valid'Access, Offset_Same'Access, ret);
        result := (Success => ret.Success, ErrorCode => ret.ErrorCode);
    end;
end if;<endif><endif>
>>

