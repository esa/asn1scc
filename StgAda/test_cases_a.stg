PrintSuite_call_codec_generate_dat_file(sModName, sTasName, sAmber, sEnc, sStreamName) ::= <<
if result.Success then
    DECLARE
    	stream   : <sModName>.<sTasName>_uPER_Stream;
        ret      : <rtlModuleName()>.ASN1_RESULT;
    begin
        <sModName>.<sTasName>_uPER_Encode(<sValue>, stream, ret);
	    WRITE_STR_TO_FILE(Strm => stream.Data,DataLen => stream.DataLen, fileName => "asn1scc_<sEnc>.dat");
    end;
end if;
>>

                   

/* bSkips (coverage cycle 15h): the suite holds guarded checks (atcSkipped); the runner prints the number of skipped
   ones as its last line, the sum of the counters of the test files arrsSkipCounters (the files with guarded tests,
   atcSkipCounterDecl). */
PrintATCRunner(sTestSuiteFilename, arrsIncludedModules, arrsVars, arrsTestFunctions, arrsUsedPackages, arrsInitCalls, bGenerateDatFile, bSkips, arrsSkipCounters) ::= <<
pragma Style_Checks (Off);
with Ada.Text_IO;
<if(bGenerateDatFile)>
with Ada.Sequential_IO;
with Interfaces;
use type Interfaces.Unsigned_8;
<endif>
with <rtlModuleName()>;
pragma Warnings (Off, "use clause for type");
use type <rtlModuleName()>.Asn1UInt;
use type <rtlModuleName()>.Asn1Int;
use type <rtlModuleName()>.BIT;
pragma Warnings (On, "use clause for type");
<arrsIncludedModules:{inc| with <inc>;}; separator="\n">
<arrsIncludedModules:{inc| use <inc>;}; separator="\n">

function MainProgram return Integer
is
    use Ada.Text_IO;
    <arrsUsedPackages:{p|USE <p>;}; separator="\n">
	pragma Warnings (Off, """totalErrors"" is not modified, could be declared constant");
    totalErrors  : INTEGER:=0;
	pragma Warnings (On, """totalErrors"" is not modified, could be declared constant");
    <arrsVars; separator="\n">
    
<if(bGenerateDatFile)>
    procedure WRITE_STR_TO_FILE(Strm : <rtlModuleName()>.BitArray; 
			        DataLen	: Natural;
                                fileName:String) is
      package Seq_IO is new Ada.Sequential_IO(<rtlModuleName()>.Asn1Byte);
      use Seq_IO;

      MASKS : constant <rtlModuleName()>.OctetBuffer (1 .. 8) := (16#80#, 16#40#, 16#20#, 16#10#, 16#08#, 16#04#, 16#02#, 16#01#);
      curByte:<rtlModuleName()>.Asn1Byte:=0;
      bitIndex:Integer;
      My_Out_File : Seq_IO.FILE_TYPE;
    begin
      Create(My_Out_File, Out_File, fileName);

      for i in 1..DataLen loop
         bitIndex := ((I-1) mod 8) +1;
         if bitIndex = 1 then
            curByte:=0;
         end if;
         if Strm(I)=1 then
           curByte := curByte OR MASKS(bitIndex);
         end if;
         if bitIndex = 8 OR I = DataLen then
            Write(My_Out_File, curByte);
         end if;
      end loop;

      Close(My_Out_File);
    end;

<endif>
begin

    <arrsTestFunctions;separator="\n\n">

    --  used to increase statement coverage
    <arrsInitCalls; separator="\n\n">

    pragma Warnings (Off, "condition can only be True if invalid values present");
    pragma Warnings (Off, "condition is always False");
    if totalErrors > 0 then
        Put_Line (Integer'Image(totalErrors) & " out of <arrsTestFunctions.Length> failed."); 
<if(bSkips)>        <atcSkipSummary(arrsSkipCounters=arrsSkipCounters)><\n><endif>        return 1;
    else
        Put_Line ("All test cases (<arrsTestFunctions.Length>) run successfully."); 
<if(bSkips)>        <atcSkipSummary(arrsSkipCounters=arrsSkipCounters)><\n><endif>        return 0;
    end if;
    pragma Warnings (On, "condition can only be True if invalid values present");
    pragma Warnings (On, "condition is always False");
end MainProgram;
>>


PrintATCRunnerDefinition() ::= <<
>>


PrintMain(sTestSuiteFilename, arrsProgramUnitNames) ::= <<
>>

invokeTestCaseAsFunc(sFuncName) ::= <<
<sFuncName> (totalErrors);
>>

/* Coverage cycle 15h: a test with guarded checks (atcSkipped); Ada counts its skips in its file's counter
   (atcSkipCounterDecl), so the call is the usual one. */
invokeGuardedTestCaseAsFunc(sFuncName) ::= <<
<sFuncName> (totalErrors);
>>

emitGuardedTestCaseAsFunc_h(sFuncName) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer);
>>

/* Coverage cycle 15h: the skip counter of a test file (sFilePkg) that holds guarded tests, in its package spec.
   Naming rule of the generated tests' own state: Ada identifiers cannot contain "__" and every other identifier can be
   built from an ASN.1 name, so the state lives in a package named after the test file's own package: that identifier
   already denotes the file's package wherever the tests run (a homograph built from an ASN.1 name is hidden there
   anyway), and the state is reached only by expanded names (Standard.<sFilePkg>.<sFilePkg>.Skipped). */
atcSkipCounterDecl(sFilePkg) ::= <<
--  coverage cycle 15h: the number of skipped guarded checks of this file (atcSkipped), reached by expanded name only
package <sFilePkg> is
    Skipped : Natural := 0;
end <sFilePkg>;
>>

/* Coverage cycle 15h: the one place that reports a skipped guarded check (its precondition did not hold at run time:
   the start value was not valid, the change wrote no other value, or a value predicted to be rejected was accepted and
   round-tripped). The check counts as passed; the runner prints the number of skips as its last line (atcSkipSummary). */
atcSkipped(sFuncName, sReason, sWhat, sFilePkg) /*nogen*/ ::= <<
Put_Line ("Test case '<sFuncName>': check skipped (<sReason>): <sWhat>");
Standard.<sFilePkg>.<sFilePkg>.Skipped := Standard.<sFilePkg>.<sFilePkg>.Skipped + 1;
>>

atcSkipSummary(arrsSkipCounters) /*nogen*/ ::= <<
Put_Line ("Guarded checks skipped (counted as passed):" & Integer'Image (<arrsSkipCounters:{f|Standard.<f>.<f>.Skipped}; separator=" + ">));
>>


emitTestCaseAsFunc_h(sFuncName) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer);
>>

emitTestCaseAsFunc_dummy_init(sTypeName, sFuncName, sDummyVarname) ::= <<
declare
   dummy : Standard.<sTypeName>;
begin 
    <sFuncName>(dummy); 
end;
>>

emitTestCaseAsFunc_dummy_init_function(sTypeName, sFuncName, sDummyVarname) ::= <<
declare
   dummy : Standard.<sTypeName>;
begin 
    dummy := <sFuncName>; 
end;
>>

emitTestCaseAsFunc(sFuncName, arrsVars, sModName, sTasName, sAmber, sEnc, bValueAssignment, sInitializeTcData, bStatic, sGenerateDatFile, arrsDummyInitStatementsNeededForStatementCoverage, sInitAmber, soEncDecPrefix) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    procedure Put (Item : String) renames Ada.Text_IO.Put;
    result      : adaasn1rtl.test_case_result;

    s1 : Ada.Calendar.Time;
    s2 : Ada.Calendar.Time;


    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data : <sModName>.<sTasName><if(bValueAssignment)> := <sInitializeTcData><endif>;
	pragma Warnings (On, "there are no others");
	
begin
    <if(arrsDummyInitStatementsNeededForStatementCoverage)>
    --  dummy statement used for calling init functions
    
    <arrsDummyInitStatementsNeededForStatementCoverage; separator="\n">
    <endif>
    --  the actual initialization with the test case data is made here.
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
    <if(!bValueAssignment)>
    <sInitializeTcData>

    <else>
    tc_data := <sInitializeTcData>;

    <endif>
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");

	pragma Warnings (Off, "object ""tc_data"" is always");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "condition is always False");
    s1 := Ada.Calendar.Clock;
    result := <if(soEncDecPrefix)><soEncDecPrefix><endif><sTasName>_<sEnc>enc_dec(tc_data,"<sFuncName>");
    s2 := Ada.Calendar.Clock;
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "object ""tc_data"" is always");
    if result.Success then
        Put("Test case '<sFuncName>' succeeded, duration was :");
        Put_Line (Duration'Image ((s2 - s1)));
    else
        case result.Step is
            when <rtlModuleName()>.TC_VALIDATE =>
                Put_Line ("Test case '<sFuncName>' failed in validation"); 
            when <rtlModuleName()>.TC_ENCODE =>
                Put_Line ("Test case '<sFuncName>' failed in encoding");
            when <rtlModuleName()>.TC_DECODE =>
                Put_Line ("Test case '<sFuncName>' failed in decoding");
            when <rtlModuleName()>.TC_VALIDATE_DECODED =>
                Put_Line ("Test case '<sFuncName>' failed in the validation of the decoded message");
            when <rtlModuleName()>.TC_EQUAL =>
                Put_Line ("Test case '<sFuncName>' failed. Encoded and decoded messages are different");
            when <rtlModuleName()>.TC_DECODE_CORRUPTED =>
                Put_Line ("Test case '<sFuncName>' failed. A corrupted copy of the encoded value was decoded to an invalid value or without an error code.");
        end case;
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
    <sGenerateDatFile>
    
end <sFuncName>;
>>

/* Automatic tests with invalid in-memory values: C only (ILangGeneric.atcEmitsInvalidValueTests). */
emitInvalidValueTestCase(sFuncName, arrsVars, sTasName, sAmber, sEnc, sInitializeTcData, bStatic, sSetInvalidValue, sIsValidFunc, sEncFunc, soEqualFunc) ::= <<
>>

/* Automatic tests with values excluded by a constraint: C only (ILangGeneric.atcEmitsInvalidValueTests). */
emitExcludedValueTestCase(sFuncName, arrsVars, sTasName, sAmber, sEnc, sInitializeTcData, bStatic, sSetExcludedValue, sIsValidFunc, sEncFunc, sDecFunc) ::= <<
>>

/* Automatic test of an ACN decoder's 'when others' arm: a stream that holds only
   an ENUMERATED code which no item uses (a gap between the item values), written
   the way the type's encoder writes an item value. Decoding must fail
   (ILangGeneric.atcEmitsInvalidStreamTests). */
emitInvalidStreamTestCase(sFuncName, arrsVars, sModName, sTasName, sEnc, sCodeVar, sCodeType, nCode, sEncodeStatement, sDecFunc) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    <sCodeVar> : constant <sCodeType> := <nCode>;
    bs         : <sModName>.<sTasName>_<sEnc>Stream := <sModName>.<sTasName>_<sEnc>Stream'(Size_In_Bytes => <sModName>.<sTasName>_<sEnc>STREAM_SIZE, Current_Bit_Pos => 0, pushDataPrm => 0, fetchDataPrm => 0, End_Bit_Pos => <sModName>.<sTasName>_<sEnc>STREAM_SIZE * 8, Buffer => (others => 0));
    result     : adaasn1rtl.ASN1_RESULT := (Success => True, ErrorCode => 0);
	pragma Warnings (Off, "is assigned but never read");
	pragma Warnings (Off, "is not referenced");
    decodedPDU : <sModName>.<sTasName>;
    <arrsVars; separator="\n">
	pragma Warnings (On, "is not referenced");
	pragma Warnings (On, "is assigned but never read");
begin
    <sEncodeStatement>
    if result.Success then
        --  the decoder resets the stream position
        <sModName>.<sDecFunc>(decodedPDU, bs, result);
        if result.Success or result.ErrorCode = 0 then
            Put_Line ("Test case '<sFuncName>' failed. A stream with the code <nCode>, which no item uses, was decoded.");
            Put_Line ("========================================");
            totalErrors := totalErrors + 1;
        else
            Put_Line ("Test case '<sFuncName>' succeeded");
        end if;
    else
        Put_Line ("Test case '<sFuncName>' failed: the stream could not be written.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

printTestCaseFileDef(sPackageName, arrsIncludedModules, arrsTestFunctionDefs) ::= <<

package <sPackageName> 
is
<arrsTestFunctionDefs:{tas|<tas>}; separator="\n">

end <sPackageName>;
>>

printTestCaseFileBody(sPackageName, arrsIncludedModules, arrsTestFunctionBodies, arrsProgramUnitNames, arrsRtlUnits) ::= <<
pragma Style_Checks (Off);
--  Code automatically generated by asn1scc tool (stg macro : printTestCaseFileBody)
with Ada.Text_IO;
with adaasn1rtl;
pragma Warnings (Off, "use clause for package ""adaasn1rtl"" has no effect");
use adaasn1rtl;
pragma Warnings (On, "use clause for package ""adaasn1rtl"" has no effect");
<if(arrsRtlUnits)>
<arrsRtlUnits:{inc|pragma Warnings (Off, "unit * is not referenced");
with <inc>;
pragma Warnings (On, "unit * is not referenced");
}>
<endif>
pragma Warnings (Off, "no entities of ""interfaces"" are referenced");
pragma Warnings (Off, "use clause for package ""Interfaces"" has no effect");
with interfaces;
use interfaces;
pragma Warnings (On, "no entities of ""interfaces"" are referenced");
pragma Warnings (On, "use clause for package ""Interfaces"" has no effect");

<arrsIncludedModules:{inc| 
pragma Warnings (Off, "no entities of ""<inc>"" are referenced");
pragma Warnings (Off, "use clause for package ""<inc>"" has no effect");
with <inc>; USE <inc>;
pragma Warnings (On, "no entities of ""<inc>"" are referenced");
pragma Warnings (On, "use clause for package ""<inc>"" has no effect");
}; separator="\n">
with Ada.Calendar;
--  a file with constraint-violation tests only does not time anything
pragma Warnings (Off, "use clause for private type ""Ada.Calendar.Time"" has no effect");
use type Ada.Calendar.Time;
pragma Warnings (On, "use clause for private type ""Ada.Calendar.Time"" has no effect");

package body <sPackageName> is

<arrsTestFunctionBodies:{vas|<vas>}; separator="\n\n"> 

end <sPackageName>;

>>

decodingCaseKind(sBody, sIdentifier) ::= <<
<sBody>
>>

/* Coverage step 11c (T2): a value just outside one constraint (only values the Ada type can hold). IsConstraintValid
   and every checked encoder must fail with the error code of that constraint. */
emitConstraintViolationTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, sInitializeTcData, bStatic, sSetInvalidValue, sWhat, sIsValidFunc, sErrCodeModule, sErrCode, arrsEncodeChecks, soEqualFunc) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    result  : adaasn1rtl.ASN1_RESULT;
    ok      : Boolean;
    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data : <sModName>.<sTasName>;
	pragma Warnings (On, "there are no others");
begin
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
    <sInitializeTcData>
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");
    --  the automatic test value is valid before the change
    result := <sModName>.<sIsValidFunc> (tc_data);
    ok := result.Success and result.ErrorCode = 0;
    if ok then
        --  <sWhat>
        <sSetInvalidValue>
        result := <sModName>.<sIsValidFunc> (tc_data);
        ok := not result.Success and result.ErrorCode = <sErrCodeModule>.<sErrCode>;
    end if;
    <arrsEncodeChecks; separator="\n">
    if ok then
        Put_Line ("Test case '<sFuncName>' succeeded");
    else
        Put_Line ("Test case '<sFuncName>' failed: <sWhat>: not rejected with <sErrCode>, or the starting value was not valid.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

constraintViolationEncodeCheck(sEncFunc, sModName, sTasName, sEnc, sAmber, sErrCodeModule, sErrCode) ::= <<
if ok then
    declare
        pragma Warnings (Off);
        bs : <sModName>.<sTasName>_<sEnc>Stream;
        pragma Warnings (On);
    begin
        <sModName>.<sEncFunc> (tc_data, bs, result);
        ok := not result.Success and result.ErrorCode = <sErrCodeModule>.<sErrCode>;
    end;
end if;
>>

/* Coverage cycle 15h (A2): a violation that the 15c P3 relaxation adds (an ALWAYS PRESENT child made absent where it
   needs no selection, a node inside element 0 of a non-empty SEQUENCE OF), as a guarded test: the start value must be
   valid (else the check is skipped), the changed value rejected with a nonzero code (an enclosing or a child check may
   fail first) and every checked encoder must fail with that code; when the validator accepts the changed value,
   <sEqualFunc> with the start value must hold both ways (the change wrote no live node: skipped), else the test fails. */
emitGuardedConstraintViolationTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, sInitializeTcData, bStatic, sSetInvalidValue, sWhat, sIsValidFunc, arrsEncodeChecks, sEqualFunc, sFilePkg) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    result  : adaasn1rtl.ASN1_RESULT;
    ok      : Boolean;
    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data : <sModName>.<sTasName>;
	pragma Warnings (On, "there are no others");
    --  the test's own state, named by the file's package (atcSkipCounterDecl): expanded names only; the types by
    --  Standard.<module> (a component of the package may have a module's name) (GNAT 13 says
    --  "never read and never assigned" of an object without initial value in a package of a subprogram, also when
    --  the subprogram reads and assigns it by an expanded name)
	pragma Warnings (Off);
    package <sFilePkg> is
        Start         : Standard.<sModName>.<sTasName>;
        ValidatorCode : Integer := 0;
    end <sFilePkg>;
	pragma Warnings (On);
begin
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
    <sInitializeTcData>
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");
    --  the start value must be valid, else the check is skipped
    result := <sModName>.<sIsValidFunc> (tc_data);
    ok := result.Success and result.ErrorCode = 0;
    if not ok then
        <atcSkipped(sFuncName=sFuncName, sReason="the start value is not valid", sWhat=sWhat, sFilePkg=sFilePkg)>
        ok := True;
    else
        <sFilePkg>.Start := tc_data;
        --  <sWhat>
        <sSetInvalidValue>
        result := <sModName>.<sIsValidFunc> (tc_data);
        if result.Success then
            --  accepted: the change must have written no live node, else the test fails
            ok := <sModName>.<sEqualFunc> (<sFilePkg>.Start, tc_data) and then <sModName>.<sEqualFunc> (tc_data, <sFilePkg>.Start);
            if ok then
                <atcSkipped(sFuncName=sFuncName, sReason="the change wrote no live node", sWhat=sWhat, sFilePkg=sFilePkg)>
            end if;
        else
            <sFilePkg>.ValidatorCode := result.ErrorCode;
            ok := <sFilePkg>.ValidatorCode /= 0;
            <arrsEncodeChecks; separator="\n">
        end if;
    end if;
    if ok then
        Put_Line ("Test case '<sFuncName>' succeeded");
    else
        Put_Line ("Test case '<sFuncName>' failed: <sWhat>: not rejected with a nonzero error code (by the validator and every checked encoder alike), and not equal to the starting value.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

guardedViolationEncodeCheck(sEncFunc, sModName, sTasName, sEnc, sAmber, sFilePkg) ::= <<
if ok then
    declare
        pragma Warnings (Off);
        bs : <sModName>.<sTasName>_<sEnc>Stream;
        pragma Warnings (On);
    begin
        <sModName>.<sEncFunc> (tc_data, bs, result);
        ok := not result.Success and result.ErrorCode = <sFilePkg>.ValidatorCode;
    end;
end if;
>>

/* Coverage step 12d: C only (invalid CHOICE selectors / ENUMERATED values, ILangGeneric.atcEmitsInvalidValueTests). */
constraintViolationUncheckedEncodeCheck(sEncFunc, sModName, sTasName, sEnc, sAmber) ::= <<
>>

/* Coverage step 11c: character nIndex (0-based) of a string set to the code nChar (0 ends the string there). */
constraintViolationStringChar(sStr, nIndex, nChar) ::= <<
<sStr>(<nIndex> + 1) := Character'Val (<nChar>);
>>

/* Coverage step 14q: characters 1 .. nCount of a string set to one character (a string longer than its maximum size). */
constraintViolationStringFill(sStr, nCount, nChar) ::= <<
<sStr>(1 .. <nCount>) := (others => Character'Val (<nChar>));
>>

/* Coverage step 14q: C only (no infinity in this backend's REAL types / no constraint-violation tests). */
constraintViolationRealInfinity(sVal, bNegative) ::= <<
>>

/* Coverage step 14f: a constraint violation that needs a selection inside a SEQUENCE OF element, set in every element
   that makes the selection (arrsGuards: the CHOICE alternatives / OPTIONAL children on the way). */
constraintViolationEveryElement(sIdx, sCount, arrsGuards, sSetInvalidValue) ::= <<
<sIdx> := 1;
while <sIdx> \<= <sCount> loop
    <if(arrsGuards)>
    if <arrsGuards; separator=" and then "> then
        <sSetInvalidValue>
    end if;
    <else>
    <sSetInvalidValue>
    <endif>
    <sIdx> := <sIdx> + 1;
end loop;
>>

/* Coverage step 14j (task 0): IsConstraintValid of a type assignment that has no test of its own (no encoding is tested,
   e.g. its ACN encoding takes ACN parameters, with -ACN only): every automatic test value must be valid. */
emitValidityTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, bStatic, sIsValidFunc, arrsValueChecks) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    result  : adaasn1rtl.ASN1_RESULT;
    ok      : Boolean := True;
    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data : <sModName>.<sTasName>;
	pragma Warnings (On, "there are no others");
begin
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
    <arrsValueChecks; separator="\n">
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");
    if ok then
        Put_Line ("Test case '<sFuncName>' succeeded");
    else
        Put_Line ("Test case '<sFuncName>' failed: <sIsValidFunc> rejected an automatic test value.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

validityCheck(sModName, sAmber, sInitializeTcData, sWhat, sIsValidFunc) ::= <<
--  <sWhat>
<sInitializeTcData>
result := <sModName>.<sIsValidFunc> (tc_data);
if not result.Success or result.ErrorCode /= 0 then
    ok := False;
    Put_Line ("  invalid: <sWhat>");
end if;
>>

/* Coverage step 14a: T_Equal with two different values (AutomaticTestCase.variants): the test value with one node
   changed must compare unequal, both ways. */
emitEqualityVariantTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, sInitializeTcData, bStatic, sEqualFunc, arrsVariantChecks, bReflexiveChecks, bGuarded) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    ok       : adaasn1rtl.Asn1Boolean := True;   --  references adaasn1rtl (a file may hold only these tests)
    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data  : <sModName>.<sTasName>;
    tc_data2 : <sModName>.<sTasName>;
	pragma Warnings (On, "there are no others");
begin
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
	--  a variant may replace the whole copy
	pragma Warnings (Off, "useless assignment to ""tc_data2""*");
    <sInitializeTcData>
    <arrsVariantChecks; separator="\n">
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");
	pragma Warnings (On, "useless assignment to ""tc_data2""*");
    if ok then
        Put_Line ("Test case '<sFuncName>' succeeded");
    else
        Put_Line ("Test case '<sFuncName>' failed: <sEqualFunc> returned True for two different values<if(bReflexiveChecks)> or False for a value and itself<endif>.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

equalityVariantCheck(sModName, sAmber, sApplyVariant, sWhat, sEqualFunc) ::= <<
--  <sWhat>
tc_data2 := tc_data;
<sApplyVariant>
if <sModName>.<sEqualFunc> (tc_data, tc_data2) or else <sModName>.<sEqualFunc> (tc_data2, tc_data) then
    ok := False;
    Put_Line ("  equal for: <sWhat>");
end if;
>>

/* Coverage cycle 15h (VR, George: Q4 = A): a variant that may write the same value at its node (another automatic
   value of an inner node lifted to the parent: two notations of one value). sDiff (atcDiff* macros, here a Boolean
   expression: the node's active contents are the same in the value and in the changed copy) compares them exactly
   and without the Equal functions under test: when they are the same the check is skipped (atcSkipped), else T_Equal
   must return False both ways. An expression, so the test declares no name of its own (atcSkipCounterDecl). */
equalityVariantCheckGuarded(sFuncName, sModName, sAmber, sApplyVariant, sWhat, sEqualFunc, sDiff, sFilePkg) ::= <<
--  <sWhat> (checked when the change wrote another value at the node)
tc_data2 := tc_data;
<sApplyVariant>
if <sDiff> then
    <atcSkipped(sFuncName=sFuncName, sReason="the change wrote the same value at the node", sWhat=sWhat, sFilePkg=sFilePkg)>
elsif <sModName>.<sEqualFunc> (tc_data, tc_data2) or else <sModName>.<sEqualFunc> (tc_data2, tc_data) then
    ok := False;
    Put_Line ("  equal for: <sWhat>");
end if;
>>

/* Coverage cycle 15h: the exact comparison of a node's active contents (equalityVariantCheckGuarded), as Boolean
   expressions that hold when the value (sV1 / sP1) and its changed copy (sV2 / sP2) are the same there. The bound
   variable of a quantified expression (atcDiffIndexName) is visible inside the expression only, which holds no name
   built from an ASN.1 name but the _PRESENT literals of CHOICE selectors. */
atcDiffIndexName(sKind, nLevel) ::= "tc_<sKind><nLevel>"

atcDiffJoin(arrsParts) ::= <<
<arrsParts:{x|(<x>)}; separator="\nand then ">
>>

atcDiffScalar(sV1, sV2) ::= <<
<sV1> = <sV2>
>>

atcDiffString(sV1, sV2) ::= <<
<sV1> = <sV2>
>>

atcDiffOctets(sP1, sP2, bFixed, nSize) ::= <<
<if(bFixed)><sP1>Data (1 .. <nSize>) = <sP2>Data (1 .. <nSize>)<else>(<sP1>Length = <sP2>Length and then <sP1>Data (1 .. <sP1>Length) = <sP2>Data (1 .. <sP2>Length))<endif>
>>

/* bit by bit: GNAT 13 compared two slices of a bit-packed array wrongly in a generated test file (09-CHOICE/015:
   Data (1 .. 1) /= Data (1 .. 1) was False for the bits 0 and 1) */
atcDiffBits(sP1, sP2, bFixed, nSize, sIdx) ::= <<
<if(bFixed)>(for all <sIdx> in 1 .. <nSize> => <sP1>Data (<sIdx>) = <sP2>Data (<sIdx>))<else>(<sP1>Length = <sP2>Length and then (for all <sIdx> in 1 .. <sP1>Length => <sP1>Data (<sIdx>) = <sP2>Data (<sIdx>)))<endif>
>>

atcDiffOptional(sP1, sP2, sAcc, sChName, soInner) ::= <<
<if(soInner)>(<sP1>.Exist.<sChName> = <sP2>.Exist.<sChName> and then (<sP1>.Exist.<sChName> = 0 or else (<soInner>)))<else><sP1>.Exist.<sChName> = <sP2>.Exist.<sChName><endif>
>>

atcDiffChoice(sP1, sP2, sAcc, arrsAlternatives) ::= <<
<if(arrsAlternatives)>(<sP1>.kind = <sP2>.kind and then (if <arrsAlternatives; separator="\nelsif "> else True))<else><sP1>.kind = <sP2>.kind<endif>
>>

atcDiffChoiceAlternative(sP1, sAcc, sPresent, sInner) ::= <<
<sP1>.kind = <sPresent> then (<sInner>)
>>

atcDiffSeqOf(sP1, sP2, sAcc, bFixed, nSize, sIdx, soInner) ::= <<
<if(bFixed)>(for all <sIdx> in 1 .. <nSize> => (<soInner>))<else><if(soInner)>(<sP1>.Length = <sP2>.Length and then (for all <sIdx> in 1 .. <sP1>.Length => (<soInner>)))<else><sP1>.Length = <sP2>.Length<endif><endif>
>>

/* Coverage cycle 15c (P4): after equalityVariantCheck, the changed value (tc_data2) compared with itself must be equal:
   the MC/DC pair of `ret and then val1.Exist.x = 1` with x absent on both sides (an ALWAYS PRESENT child made absent). */
equalityReflexiveCheck(sModName, sAmber, sWhat, sEqualFunc) ::= <<
if not <sModName>.<sEqualFunc> (tc_data2, tc_data2) then
    ok := False;
    Put_Line ("  <sEqualFunc> returned False for a value and itself: <sWhat>");
end if;
>>

/* Coverage step 14d: a value whose ACN fields disagree (one consumer of a shared field changed): the ACN encoder must
   reject it with a nonzero error code.
   Coverage cycle 15h (soDecFunc, Issue 144): when the encoder accepts the value, it must round-trip: decode (from the
   encoded length for a 'size deduced' PDU, bDeduced), <sEqualFunc> with the value, and the decoded value encoded again
   to the same bits; then the fields agreed after all and the check is skipped (atcSkipped). Anything else fails. The
   test's own state lives in a package named after the file's package (atcSkipCounterDecl): expanded names only. */
emitInconsistentValueTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, sInitializeTcData, bStatic, sChange, sWhat, sEncFunc, sEnc, soDecFunc, sEqualFunc, bDeduced, sFilePkg) ::= <<
procedure <sFuncName> ( totalErrors : in out Integer)
is
    procedure Put_Line (Item : String) renames Ada.Text_IO.Put_Line;
    result  : adaasn1rtl.ASN1_RESULT;
    <arrsVars; separator="\n">
	pragma Warnings (Off, "there are no others");
    tc_data : <sModName>.<sTasName>;
	pragma Warnings (On, "there are no others");
	pragma Warnings (Off);
    bs : <sModName>.<sTasName>_<sEnc>Stream;
	pragma Warnings (On);
    <if(soDecFunc)>
	pragma Warnings (Off);
    package <sFilePkg> is
        Ok    : Boolean := False;
        NBits : Natural := 0;
        Dec   : Standard.<sModName>.<sTasName>;
        Bs2   : Standard.<sModName>.<sTasName>_<sEnc>Stream;
    end <sFilePkg>;
	pragma Warnings (On);
    <endif>
begin
	pragma Warnings (Off, "there are no others");
	pragma Warnings (Off, "condition can only be True if invalid values present");
	pragma Warnings (Off, "condition can only be False if invalid values present");
	pragma Warnings (Off, "condition is always False");
	pragma Warnings (Off, "condition is always True");
	pragma Warnings (Off, "is always True at this point");
	pragma Warnings (Off, "is always False at this point");
    <sInitializeTcData>
    --  <sWhat>
    <sChange>
	pragma Warnings (On, "there are no others");
	pragma Warnings (On, "condition can only be True if invalid values present");
	pragma Warnings (On, "condition can only be False if invalid values present");
	pragma Warnings (On, "condition is always False");
	pragma Warnings (On, "condition is always True");
	pragma Warnings (On, "is always True at this point");
	pragma Warnings (On, "is always False at this point");
    <sModName>.<sEncFunc> (tc_data, bs, result);
    <if(soDecFunc)>
    <inconsistentValueRoundTrip(sFuncName=sFuncName, sModName=sModName, sTasName=sTasName, sWhat=sWhat, sEncFunc=sEncFunc, sEnc=sEnc, sDecFunc=soDecFunc, sEqualFunc=sEqualFunc, bDeduced=bDeduced, sFilePkg=sFilePkg)>
    if <sFilePkg>.Ok then
    <else>
    if not result.Success and result.ErrorCode /= 0 then
    <endif>
        Put_Line ("Test case '<sFuncName>' succeeded");
    else
        Put_Line ("Test case '<sFuncName>' failed: <sWhat>: the ACN fields of the value disagree, but <sEncFunc> did not fail with an error code<if(soDecFunc)> (and the accepted value did not round-trip)<endif>.");
        Put_Line ("========================================");
        totalErrors := totalErrors + 1;
    end if;
end <sFuncName>;
>>

/* Coverage cycle 15h: the round trip of an accepted 14d value (emitInconsistentValueTestCase). */
inconsistentValueRoundTrip(sFuncName, sModName, sTasName, sWhat, sEncFunc, sEnc, sDecFunc, sEqualFunc, bDeduced, sFilePkg) /*nogen*/ ::= <<
<sFilePkg>.Ok := not result.Success and result.ErrorCode /= 0;
--  (an Ada encoder / decoder that succeeds may leave a nonzero ErrorCode: its Success decides)
if result.Success then
    --  accepted: the value must decode to an equal value and encode to the same bits again
    <sFilePkg>.NBits := bs.Current_Bit_Pos;
    bs.Current_Bit_Pos := 0;
    <if(bDeduced)>
    --  'size deduced' PDU: the decoder takes the element counts from the end of the encoded length
    bs.End_Bit_Pos := ((<sFilePkg>.NBits + 7) / 8) * 8;
    <sModName>.<sDecFunc>_aux (<sFilePkg>.Dec, bs, result);
    <else>
    <sModName>.<sDecFunc> (<sFilePkg>.Dec, bs, result);
    <endif>
    <sFilePkg>.Ok := result.Success and then
          <sModName>.<sEqualFunc> (tc_data, <sFilePkg>.Dec) and then <sModName>.<sEqualFunc> (<sFilePkg>.Dec, tc_data);
    if <sFilePkg>.Ok then
        <sModName>.<sEncFunc> (<sFilePkg>.Dec, <sFilePkg>.Bs2, result);
        <sFilePkg>.Ok := result.Success and then
              <sFilePkg>.Bs2.Current_Bit_Pos = <sFilePkg>.NBits and then <sFilePkg>.Bs2.Buffer = bs.Buffer;
    end if;
    if <sFilePkg>.Ok then
        <atcSkipped(sFuncName=sFuncName, sReason="the value predicted to be rejected was accepted and round-trips, so its ACN fields agree", sWhat=sWhat, sFilePkg=sFilePkg)>
    end if;
end if;
>>
