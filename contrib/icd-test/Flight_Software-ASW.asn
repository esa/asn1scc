ASW-PARAMETER-MONITORING-DEFINITION-CHECK-VALIDITY-CONDITION-SEQUENCE-OF ::= SEQUENCE (SIZE(0..255)) OF ASW-PARAMETER-MONITORING-DEFINITION-CHECK-VALIDITY-CONDITION
asw-parameter-monitoring-definition-check-validity-condition-value ASW-PARAMETER-MONITORING-DEFINITION-CHECK-VALIDITY-CONDITION-SEQUENCE-OF ::= { { validity-parameter-id test-param-3, mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE}, expected-value { field-data '6C6C'H }}, { validity-parameter-id test-param-1, mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE}, expected-value { field-data '2C2C'H }}, { validity-parameter-id test-param-2, mask {TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE}, expected-value { field-data '2B2B'H }}, { validity-parameter-id test-param-1, mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE}, expected-value { field-data '2C2C'H }}, { validity-parameter-id test-param-3, mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE}, expected-value { field-data '6C6C'H }}, { validity-parameter-id test-param-2, mask {TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE}, expected-value { field-data '2B2B'H }} }

