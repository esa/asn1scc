ASW-FMON-FUNCTION-STATUS ::= ENUMERATED {
	disabled (0),
	enabled (1)
}

asw-fmon-function-status-default-value ASW-FMON-FUNCTION-STATUS ::= disabled


ASW-FMON-SLOT-GENERIC ::= SEQUENCE {
	fmon-id ASW-FMON-ID,
	check-validity-condition ASW-CHECK-VALIDITY-CONDITION OPTIONAL,
	event-definition-id ASW-EVENT-IDENTIFIER,
	minimum-pmon-failing-number ASW-MINIMUM-PMON-FAILING-NUMBER,
	pmon-ids ASW-PMON-IDS,
	fmon-checking-status ASW-FMON-CHECKING-STATUS,
	fmon-status ASW-FMON-STATUS,
	fmon-protection-status ASW-FMON-PROTECTION-STATUS OPTIONAL,
	is-slot-used ASW-IS-SLOT-USED
}

ASW-FMON-SLOT ::= ASW-FMON-SLOT-GENERIC (WITH COMPONENTS { check-validity-condition PRESENT, fmon-protection-status PRESENT })

asw-fmon-ids-maximum-size ROOT-UINT32 ::= 8
ASW-FMON-IDS ::= SEQUENCE { field-data SEQUENCE (SIZE(0..8)) OF ASW-FMON-ID }

ASW-EVENT-ACTION-FUNCTION-STATUS ::= ENUMERATED {
	disabled (0),
	enabled (1)
}

asw-event-action-function-status-default-value ASW-EVENT-ACTION-FUNCTION-STATUS ::= disabled


ASW-EVENT-ACTION-DEFINITION-SLOT-GENERIC ::= SEQUENCE {
	system-identifier ASW-SYSTEM-IDENTIFIER,
	request ASW-REQUEST,
	status ASW-EVENT-ACTION-STATUS,
	is-slot-used ASW-IS-SLOT-USED
}

ASW-EVENT-ACTION-DEFINITION-SLOT ::= ASW-EVENT-ACTION-DEFINITION-SLOT-GENERIC

asw-super-commuted-parameter-sets-system-object-value-maximum-size ROOT-UINT32 ::= 8
ASW-SUPER-COMMUTED-PARAMETER-SETS-SYSTEM-OBJECT-VALUE ::= SEQUENCE { field-data SEQUENCE (SIZE(0..8)) OF ASW-SUPER-COMMUTED-PARAMETER-SET }


ASW-TC-SECONDARY-HEADER ::= SEQUENCE {
   ack-successful-completion   BOOLEAN,
   ack-successful-progress     BOOLEAN,
   ack-successful-start        BOOLEAN,
   ack-successful-acceptance   BOOLEAN,
   source-id                   ROOT-APPLICATION-PROCESS-USER-ID
   -- spare user defined
}

ASW-TM-SECONDARY-HEADER ::= SEQUENCE {
   time-reference-status       ROOT-TIME-REFERENCE-STATUS,
   message-type-counter        ROOT-MESSAGE-TYPE-COUNTER,
   destination-id              ROOT-APPLICATION-PROCESS-USER-ID
   -- time TODO
   -- spare user defined
}

ASW-TELECOMMAND ::= SEQUENCE {
   packet-secondary-header     ASW-TC-SECONDARY-HEADER,
   user-data-field             ASW-TC-PAYLOAD
}

ASW-TELEMETRY ::= SEQUENCE {
   packet-secondary-header     ASW-TM-SECONDARY-HEADER,
   user-data-field             ASW-TM-PAYLOAD
}

ASW-HEADERLESS-TELEMETRY ::= SEQUENCE {
   user-data-field             ASW-HEADERLESS-TM-PAYLOAD
}

ASW-DECODED-TELECOMMAND-DATA ::= SEQUENCE {
   request-id ASW-REQUEST-ID,
   telecommand ASW-TELECOMMAND
}

ASW-TELEMETRY-DATA ::= SEQUENCE {
   destination ROOT-APPLICATION-PROCESS-USER-ID,
   telemetry ASW-TELEMETRY
}

ASW-HEADERLESS-TELEMETRY-DATA ::= SEQUENCE {
   telemetry ASW-HEADERLESS-TELEMETRY
}

END