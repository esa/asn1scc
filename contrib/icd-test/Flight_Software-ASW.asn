asw-parameter-monitoring-definition-check-type-dependent-criteria-value ASW-PARAMETER-MONITORING-DEFINITION-CHECK-TYPE-DEPENDENT-CRITERIA-SEQUENCE-OF ::= { limit-checking : { low-limit { field-data '6C6C'H },  low-limit-event-definition-id test-high-event, high-limit { field-data '8C8C'H }, high-limit-event-definition-id test-low-event }, expected-value-checking : { mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE},  spare {TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE}, expected-value { field-data '0C0C'H }, event-definition-id test-inf-event }, delta-checking : { low-delta-threshold { field-data '6E6E'H },  low-delta-event-definition-id test-low-event, high-delta-threshold { field-data '8F8F'H }, high-delta-event-definition-id test-mid-event, number-of-consecutive-delta-values 4 }, expected-value-checking : { mask {TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE},  spare {TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE}, expected-value { field-data '0C0C'H }, event-definition-id test-inf-event }, limit-checking : { low-limit { field-data '6C6C'H },  low-limit-event-definition-id test-high-event, high-limit { field-data '8C8C'H }, high-limit-event-definition-id test-low-event }, delta-checking : { low-delta-threshold { field-data '6E6E'H },  low-delta-event-definition-id test-low-event, high-delta-threshold { field-data '8F8F'H }, high-delta-event-definition-id test-mid-event, number-of-consecutive-delta-values 4 } }

