	padding NULL [pattern '0000'B],
	field-data [] 
}


ASW-TELECOMMAND                 [] {
   packet-secondary-header             [] {
      tc-packet-version                NULL [pattern '0010'B],
      ack-successful-completion        [true-value '1'B],
      ack-successful-progress          [true-value '1'B],
      ack-successful-start             [true-value '1'B],
      ack-successful-acceptance        [true-value '1'B],
      service-type-id                  ASW-TYPE-ID[],
      message-subtype-id               ASW-TYPE-ID[],
      source-id                        []
   },
   user-data-field                     <packet-secondary-header.service-type-id, packet-secondary-header.message-subtype-id> []
}

ASW-TELEMETRY                   [] {
   packet-secondary-header             [] {
      tc-packet-version                NULL [pattern '0010'B],
      time-reference-status            [],
      service-type-id                  ASW-TYPE-ID[],
      message-subtype-id               ASW-TYPE-ID[],
      message-type-counter             [size 16, encoding pos-int],
      destination-id                   []
   },
   user-data-field                     <packet-secondary-header.service-type-id, packet-secondary-header.message-subtype-id> []
}

ASW-HEADERLESS-TELEMETRY        [] {
   user-data-field                     []
}

END