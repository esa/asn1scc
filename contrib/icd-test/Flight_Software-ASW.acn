ASW-HOUSEKEEPING-TC <ASW-TYPE-ID: message-subtype-id> [] {
	enable-the-periodic-generation-of-housekeeping-parameter-reports [present-when message-subtype-id==5],
	disable-the-periodic-generation-of-housekeeping-parameter-reports [present-when message-subtype-id==6],
	create-a-housekeeping-parameter-report-structure [present-when message-subtype-id==1],
	delete-housekeeping-parameter-report-structures [present-when message-subtype-id==3],
	report-housekeeping-parameter-report-structures [present-when message-subtype-id==9],
	generate-a-one-shot-report-for-housekeeping-parameter-report-structures [present-when message-subtype-id==27],
	append-parameters-to-a-housekeeping-parameter-report-structure [present-when message-subtype-id==29],
	modify-the-collection-interval-of-housekeeping-parameter-report-structures [present-when message-subtype-id==31],
	report-the-periodic-generation-properties-of-housekeeping-parameter-report-structures [present-when message-subtype-id==33],
	apply-parameter-functional-reporting-configurations [present-when message-subtype-id==37],
	create-a-parameter-functional-reporting-definition [present-when message-subtype-id==38],
	delete-parameter-functional-reporting-definitions [present-when message-subtype-id==39],
	report-parameter-functional-reporting-definitions [present-when message-subtype-id==40],
	add-parameter-report-definitions-to-a-parameter-functional-reporting-definition [present-when message-subtype-id==42],
	remove-parameter-report-definitions-from-a-parameter-functional-reporting-definition [present-when message-subtype-id==43],
	modify-the-periodic-generation-properties-of-parameter-report-definitions-of-a-parameter-functional-reporting-definition [present-when message-subtype-id==44]
}

