CCSDS-SPACE-PACKET DEFINITIONS ::=
BEGIN

ROOT-APPLICATION-PROCESS-ID              [encoding pos-int, size 11]
ROOT-PACKET-SEQUENCE-COUNT               [encoding pos-int, size 14]
ROOT-TIME-REFERENCE-STATUS               [encoding pos-int, size 4]
ROOT-MESSAGE-TYPE-COUNTER                [encoding pos-int, size 16]
ROOT-APPLICATION-PROCESS-USER-ID         [encoding pos-int, size 16]
TYPE-ID                                  [encoding pos-int, size 8]
TELEMETRY-SECONDARY-HEADER-PRESENCE-FLAG [encoding pos-int, size 1]
ROOT-PACKET-ERROR-CONTROL                [encoding pos-int, size 16]
ROOT-BOOLEAN                             [true-value '1'B]

ROOT-PACKET-VERSION-NUMBER [size 3, encoding pos-int, encode-values]
ROOT-PACKET-TYPE [size 1, encoding pos-int, encode-values]
ROOT-SECONDARY-HEADER-FLAG [true-value '1'B]
ROOT-PACKET-ID [] {
   packet-type [],
   secondary-header-flag [],
   application-process-id []
}
ROOT-SEQUENCE-FLAGS [size 2, encoding pos-int, encode-values]
ROOT-PACKET-SEQUENCE-CONTROL [] {
   sequence-flags [],
   packet-sequence-count []
}
ROOT-REQUEST-ID [] {
   packet-version-number [],
   packet-id [],
   packet-sequence-control []
}

ROOT-ROUTING-FAILURE-NOTICE-CODE [size 8, encoding pos-int, encode-values]
ROOT-ROUTING-FAILURE-NOTICE-DATA []
ROOT-ROUTING-FAILURE-NOTICE [] {
   failure-notice-code ROOT-ROUTING-FAILURE-NOTICE-CODE [],
   failure-notice-data [determinant failure-notice-code]
}

ROOT-SPACE-PACKET-TELECOMMAND          [] {
   packet-version-number               NULL [pattern '000'B],
   packet-type                         NULL [pattern '1'B],
   secondary-header-flag               [size 1, encoding pos-int],
   application-process-id              [],
   sequence-flags                      NULL [pattern '11'B],
   packet-sequence-count               [],
   packet-data-length                  ROOT-PACKET-DATA-LENGTH [encoding pos-int, size 16, mapping-function puscpayloadlength],
   packet-data-field                   [size packet-data-length],
   packet-error-control                [align-to-next byte, size 16, encoding pos-int]
}

ROOT-SPACE-PACKET-TELEMETRY            [] {
   packet-version-number               NULL [pattern '000'B],
   packet-type                         NULL [pattern '0'B],
   secondary-header-flag               [size 1, encoding pos-int],
   application-process-id              [],
   sequence-flags                      NULL [pattern '11'B],
   packet-sequence-count               [],
   packet-data-length                  ROOT-PACKET-DATA-LENGTH [encoding pos-int, size 16, mapping-function puscpayloadlength],
   packet-data-field                   [size packet-data-length],
   packet-error-control                [align-to-next byte, size 16, encoding pos-int]
}

END