group xml;

//delimiters "$", "$"


RootXml(arrsFiles, arrsSortedTypeAssignmentRefs) ::= <<
<?xml version="1.0" encoding="utf-8"?>
<ASN1AST>
    $arrsSortedTypeAssignmentRefs;separator="\n"$
    $arrsFiles;separator="\n"$
</ASN1AST>
>>


TypeAssignmentReference(sModuName, sTasName) ::= <<
<TypeAssignmentReference ModuleName="$sModuName; format="xml"$" TypeAssignmentName="$sTasName; format="xml"$"/>
>>

FileXml(sFileName, arrsModules) ::= <<
<Asn1File FileName="$sFileName; format="xml"$">
    $arrsModules;separator="\n"$
</Asn1File>
>>

ModuleXml(sName, sCName, arrsImportedModules, arrsExpTypes, arrsExpVars, arrsTases, arrsVases) ::=<<
<Asn1Module ID="$sName; format="xml"$">
<ExportedTypes>
    $arrsExpTypes:{x|<ExportedType Name="$x; format="xml"$" />};separator="\n"$
</ExportedTypes>
<ExportedVariables>
    $arrsExpVars:{x|<ExportedVariable Name="$x; format="xml"$" />};separator="\n"$
</ExportedVariables>
<ImportedModules>
    $arrsImportedModules;separator="\n"$
</ImportedModules>
<TypeAssignments>
    $arrsTases;separator="\n"$
</TypeAssignments>
<VariablesAssignments>
    $arrsVases;separator="\n"$
</VariablesAssignments>
</Asn1Module>
>>

ImportedMod(sName, sCName, arrsTypes, arrsVars) ::= <<
<ImportedModule ID="$sName; format="xml"$">
    <ImportedTypes>
        $arrsTypes:{t|<ImportedType Name="$t; format="xml"$" />};separator="\n"$
    </ImportedTypes>
    <ImportedVariables>
        $arrsVars:{t|<ImportedVariable Name="$t; format="xml"$" />};separator="\n"$
    </ImportedVariables>
</ImportedModule>
>>

TasXml(sName, nLine, nPos, sType, sCName, sAssignOp, sContract, bAddedType) ::= <<
<TypeAssignment Name="$sName; format="xml"$" Line="$nLine$" CharPositionInLine="$nPos$"  AddedType = "$bAddedType$">
    $sType$
</TypeAssignment>
>>

VasXml(sName, nLine, nPos, sType, sValue, sCName) ::= <<
<VariableAssignment Name="$sName; format="xml"$" Line="$nLine$" CharPositionInLine="$nPos$">
    $sType$
    <Value>$sValue$</Value>
</VariableAssignment>
>>

TypeGeneric(nLine, nPos, sAsnFile, sSubType, bHasAcnEncDecFunction, sCName, sScalaName, sAdaName) ::= <<
<Type Line="$nLine$" CharPositionInLine="$nPos$" Asn1File="$sAsnFile; format="xml"$" HasAcnEncDecFunction = "$bHasAcnEncDecFunction$" cName="$sCName; format="xml"$" scalaName="$sScalaName; format="xml"$" adaName="$sAdaName; format="xml"$">
    $sSubType$
</Type>
>>


MinMaxType(sName, sMin, sMax, bFixedSize, bIsUnsigned, bIsRealType) ::= <<
<$sName$ Min="$sMin; format="xml"$" Max="$sMax; format="xml"$"/>
>>

MinMaxType2(sName, sMin, sMax, bFixedSize) ::= <<
<$sName$ Min="$sMin; format="xml"$" Max="$sMax; format="xml"$">
</$sName$>
>>


BooleanType () ::= "<BooleanType />"

NullType () ::= "<NullType />"
IntegerType () ::= "IntegerType"

RealType () ::= "RealType"

BitStringNamedBit(sName, nVal, nLine, nPos) ::= <<
<NamedBit Name="$sName; format="xml"$" Value="$nVal$" Line="$nLine$" CharPositionInLine="$nPos$"/>
>>

BitStringType (sMin, sMax, bFixedSize, arrsNamedBits) ::= <<
<BitStringType Min="$sMin; format="xml"$" Max="$sMax; format="xml"$">
    $arrsNamedBits;separator="\n"$
</BitStringType>
>>



OctetStringType () ::= "OctetStringType"

IA5StringType () ::= "IA5StringType"

NumericStringType () ::= "NumericStringType"

AssignOpNormalType () ::= "="
AssignOpSpecialType () ::= "="



EnumItem (sName, sCName, nVal, nLine, nPos, sCID) ::= <<
<EnumValue StringValue="$sName; format="xml"$" IntValue="$nVal$" Line="$nLine$" CharPositionInLine="$nPos$" EnumID ="$sCID; format="xml"$" />
>>

EnumType(arrsItems) ::= <<
<EnumeratedType Extensible="False" ValuesAutoCalculated="False">
    <EnumValues>
        $arrsItems;separator="\n"$
    </EnumValues>
</EnumeratedType>
>>


ChoiceChild(sName, sCName, sScala, sAdaName, nLine, nPos, sChildContent, sNamePresent, bRemovedChild  ) ::= <<
<ChoiceChild VarName="$sName; format="xml"$" Line="$nLine$" CharPositionInLine="$nPos$" EnumID ="$sNamePresent; format="xml"$" RemovedChild="$bRemovedChild$">
    $sChildContent$
</ChoiceChild>
>>

ChoiceType(arrsChildren) ::= <<
<ChoiceType>
    $arrsChildren;separator="\n"$
</ChoiceType>
>>


SequenceChild(sName, sCName, sScalaName, sAdaName, bOptional, sDefVal, nLine, nPos, sChildContent, bAlwaysPresent, bAlwaysAbsent ) ::= <<
<SequenceOrSetChild VarName="$sName; format="xml"$" CName="$sCName; format="xml"$" ScalaName="$sScalaName; format="xml"$" AdaName="$sAdaName; format="xml"$" Optional="$bOptional$"$if(sDefVal)$ DefaultValue="$sDefVal.HtmlEsc$"$endif$ Line="$nLine$" CharPositionInLine="$nPos$" bAlwaysPresent = "$bAlwaysPresent$" bAlwaysAbsent="$bAlwaysAbsent$">
    $sChildContent$
</SequenceOrSetChild>
>>

SequenceType(arrsChildren) ::= <<
<SequenceType>
    $arrsChildren;separator="\n"$
</SequenceType>
>>


SequenceOfType(sMin, sMax, sChild, bFixedSize) ::= <<
<SequenceOfType Min="$sMin; format="xml"$" Max="$sMax; format="xml"$">
    $sChild$
</SequenceOfType>
>>

RefTypeMinMax(sMin, sMax, sName, sModName, sCName, sCModName, bFixedSize, soResolvedType) ::= <<
<ReferenceType ReferencedTypeName="$sName; format="xml"$" Min="$sMin; format="xml"$" Max="$sMax; format="xml"$"$if(sModName)$ ReferencedModName="$sModName; format="xml"$"$endif$/>
>>

RefType(sName, sModName, sCName, sCModName, soResolvedType) ::= <<
$if(soResolvedType)$
<ReferenceType ReferencedTypeName="$sName; format="xml"$"$if(sModName)$ ReferencedModName="$sModName; format="xml"$"$endif$>
    $soResolvedType$
</ReferenceType>

$else$
<ReferenceType ReferencedTypeName="$sName; format="xml"$"$if(sModName)$ ReferencedModName="$sModName; format="xml"$"$endif$/>

$endif$
>>

/* Possible additional information generated after the type itself */
Contract(sTypePattern, sExpr) ::= ""
TypePatternCommonTypes() ::= ""
TypePatternSequence(sName, sCName, arrsChildren) ::= ""
SequencePatternChild(sName, sCName) ::= ""
ContractExprMinMax(sPattern, sMin, sMax, bFixedSize) ::= ""
ContractExprSize(sPattern, sMin, sMax, bFixedSize) ::= ""
ContractExprSequence(arrsChildren) ::= ""
/* Print Values (not implemented yet for python) */
Print_IntegerValue(nVal) ::= "$nVal$"
Print_RealValue(dVal) ::= "$dVal$"
Print_StringValue(v) ::= <<<![CDATA[$v; format="cdata"$]]\>>>
Print_TrueValue() ::= "true"
Print_FalseValue() ::= "false"
Print_BitStringValue(v) ::= "$v$"
Print_OctetStringValue(arruOctets) ::= "'$arruOctets:{b|$b;format=\"X2\"$}$'H"
Print_RefValue(sName) ::= "$sName$"
Print_SeqOfValue(arrsValues) ::= "{$arrsValues: {ch|$ch$}; separator=\", \"$}"
Print_SeqValue_Child(sName, sChildValue) ::= "$sName$ $sChildValue$"
Print_SeqValue(arrsValues) ::= "{$arrsValues: {ch|$ch$}; separator=\", \"$}"
Print_ChValue(sAltName,sAltValue) ::= "$sAltName$:$sAltValue$"
Print_NullValue() ::= "NULL"
Print_EnmValueValue(sEnmVal) ::= "$sEnmVal$"
