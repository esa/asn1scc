group python;

//delimiters "$", "$"

/* SECURITY: the output of this template is Python source that consumers (e.g. OpenGEODE) execute.
   Every attribute placed inside a Python string literal MUST use format="python" (escapes quotes,
   backslashes, control and non-ASCII characters): file names and ASN.1 string values are free text
   controlled by whoever wrote the input files (ESACERT #75543). */

/* Header of the file */
RootXml(arrsFiles, arrsSortedTypeAssignmentRefs) ::= <<
#!/usr/bin/env python
# ASN.1 Data model
asn1Files = []
asn1Modules = []
exportedTypes = {}
exportedVariables = {}
importedModules = {}
types = {}
variables = {}
$arrsFiles;separator="\n"$
>>

TypeAssignmentReference(sModuName, sTasName) ::= <<
>>

/* sFileName is a string with the current file name */
FileXml(sFileName, arrsModules) ::= <<
asn1Files.append("$sFileName; format="python"$")
$arrsModules;separator="\n"$
>>


/* Per ASN.1 module. you can use:
  - the module name ($sName$)
  - the list of types that are exported by this module.
    Example of use:
    $arrsExpTypes:{x|"$x; format="python"$"};separator=", "$
  - the list of variables that are exported by this module (arrsExpVars)
  - the list of imported modules (generated by template ImportedMod)
 Then you can use the list of types and variables defined in this module
 arrsTases is an array of strings generated by template TasXml
 arrsVases is an array of strings generated by template VasXml
*/
ModuleXml(sName, sCName, arrsImportedModules, arrsExpTypes, arrsExpVars, arrsTases, arrsVases) ::=<<
asn1Modules.append("$sName; format="python"$")
exportedTypes["$sName; format="python"$"] = [$arrsExpTypes:{x|"$x; format="python"$"};separator=", "$]
exportedVariables["$sName; format="python"$"] = [$arrsExpVars:{x|"$x; format="python"$"};separator=", "$]
importedModules["$sName; format="python"$"] = [$arrsImportedModules:{x|$x$};separator=", "$]

$arrsTases;separator="\n"$

$arrsVases;separator="\n"$
>>


/* An imported module with a list of imported types and variables */
ImportedMod(sName, sCName, arrsTypes, arrsVars) ::= <<
{"$sName; format="python"$":{"ImportedTypes": [$arrsTypes:{t|"$t; format="python"$"};separator=","$], "ImportedVariables": [$arrsVars:{t|"$t; format="python"$"};separator=","$]}}
>>


/* A single Type Assignment, this is filled for all types of all modules */
TasXml(sName, nLine, nPos, sType, sCName, sAssignOp, sContract, bAddedType) ::= <<
types["$sName; format="python"$"] = type("$sName; format="python"$", (object,), {
    "Line": $nLine$, "CharPositionInLine": $nPos$, "CName": "$sCName; format="python"$", "AddedType": "$bAddedType$", "type": type("$sName; format="python"$_type", (object,), {
        $sType$
    })
})

>>


/* A single Variable Assignment (actual value not handled in python yet) */
VasXml(sName, nLine, nPos, sType, sValue, sCName) ::= <<
variables["$sName; format="python"$"] = type("$sName; format="python"$", (object,), {
    "Line": $nLine$,
    "CharPositionInLine": $nPos$,
    "varName": "$sCName; format="python"$",
    "type": type("$sName; format="python"$_type", (object,), {
        $sType$
    }),
    "value": $sValue$
})

>>

TypeGeneric(nLine, nPos, sAsnFile, sSubType, bHasAcnEncDecFunction, sCName, sScalaName, sAdaName) ::= <<
"AsnFile": "$sAsnFile; format="python"$", "Line": $nLine$, "CharPositionInLine": $nPos$, "CName": "$sCName; format="python"$", "ScalaName": "$sScalaName; format="python"$", "AdaName": "$sAdaName; format="python"$", "HasAcnEncDec": $bHasAcnEncDecFunction$, $sSubType$
>>


/* Type with Min and Max constraint. sName is the type kind
   This template is used for Integer and Real types; for others,
   see MinMaxType2 */
MinMaxType(sName, sMin, sMax, bFixedSize, bIsUnsigned, bIsRealType) ::= <<
"kind": "$sName; format="python"$", "Min": "$sMin; format="python"$", "Max": "$sMax; format="python"$"
>>


/* String types with size constraint: Bitstring, Octetstring, Ia5String,
   NumericString */
MinMaxType2(sName, sMin, sMax, bFixedSize) ::= <<
"kind": "$sName; format="python"$", "Min": "$sMin; format="python"$", "Max": "$sMax; format="python"$"
>>

BooleanType () ::= <<"kind": "BooleanType">>

NullType () ::= <<"kind": "NullType">>

/* Integer and RealType full spec in MinMaxType */
IntegerType () ::= "IntegerType"

RealType () ::= "RealType"

/* String type full spec in MixMaxType2 */

BitStringNamedBit(sName, nVal, nLine, nPos) ::= <<
"$sName; format="python"$": $nVal$ 
>>

BitStringType (sMin, sMax, bFixedSize, arrsNamedBits) ::= <<
"kind": "BitStringType", "Min": "$sMin; format="python"$", "Max": "$sMax; format="python"$", "NamedBits": {
    $arrsNamedBits;separator=", "$
}
>>

OctetStringType () ::= "OctetStringType"

IA5StringType () ::= "IA5StringType"

NumericStringType () ::= "NumericStringType"


AssignOpNormalType () ::= "="
AssignOpSpecialType () ::= "::"

/* Enumerated item, note the difference between sName, which is the enumerated
   name given in the input type, for example if you have
   MyType ::= ENUMERATED { a, b, c } then sName can be a, b or c
   and sCID which is a name built by the parser for removing ambiguities in
   some languages, e.g. if you have two types with the same enumerated name:
   MyOtherType ::= ENUMERATED { b, x, y }
   When this case happens, sCID will be either "MyType_b" or "MyOtherType_b"
   Check if your language needs this or not (C does, Ada does not)
   note: the renaming policy can be controlled with the command line of asn1scc
   for VDM: assuming sCID, to be checked
   nVal is the integer value of the enumerated, use it if needed
*/
EnumItem (sName, sCName, nVal, nLine, nPos, sCID) ::= <<
"$sName; format="python"$": type("$sCID; format="python"$", (object,), {
    "IntValue": $nVal$, "Line": $nLine$, "CharPositionInLine": $nPos$, "EnumID": "$sCID; format="python"$"
})
>>


/* Enumerated type: arrsItems is an array of EnumItem */
EnumType(arrsItems) ::= <<
"kind": "EnumeratedType", "Extensible": "False", "ValuesAutoCalculated": "False", "EnumValues": {
    $arrsItems;separator=",\n"$
}
>>


/* Choice field
   Choice are discriminated unions, they have a name per field and a type :
   MyCHOICE ::= CHOICE {
       choice-a   Type-of-A,   -- choice-a is sName
       choice-b   Type-of-B,
       ...
  }
  sNamePresent is an unambiguous name to access the field
*/
ChoiceChild(sName, sCName, sScala, sAdaName, nLine, nPos, sChildContent, sNamePresent, bRemovedChild  ) ::= <<
"$sName; format="python"$": type("$sNamePresent; format="python"$", (object,), {
    "Line": $nLine$, "CharPositionInLine": $nPos$, "EnumID": "$sNamePresent; format="python"$", "type": type("$sNamePresent; format="python"$_type", (object,), {
        $sChildContent$
    })
})
>>

ChoiceType(arrsChildren) ::= <<
"kind": "ChoiceType", "Children": {
    $arrsChildren;separator=",\n"$
}
>>


/* Sequence (record) field. May be optional and may have a default value */
/* NOTE: Optional is a string ("True" or "False") - changing to native boolean would break Opengeode and asn1-value-editor */
SequenceChild(sName, sCName, sScalaName, sAdaName, bOptional, sDefVal, nLine, nPos, sChildContent, bAlwaysPresent, bAlwaysAbsent ) ::= <<
"$sName; format="python"$": type("$sName; format="python"$", (object,), {
    "CName": "$sCName; format="python"$", "ScalaName": "$sScalaName; format="python"$", "AdaName": "$sAdaName; format="python"$", "Optional": "$bOptional$", "alwaysPresent": $bAlwaysPresent$, "alwaysAbsent": $bAlwaysAbsent$$if(sDefVal)$, "DefaultValue": "$sDefVal; format="python"$"$endif$, "Line": $nLine$, "CharPositionInLine": $nPos$, "type": type("$sName; format="python"$_type", (object,), {
        $sChildContent$
    })
})
>>


/* Full sequence (record) type */
SequenceType(arrsChildren) ::= <<
"kind": "SequenceType", "Children": {
    $arrsChildren;separator=",\n"$
}
>>


/* Sequence of (array) */
SequenceOfType(sMin, sMax, sChild, bFixedSize) ::= <<
"kind": "SequenceOfType", "Min": "$sMin; format="python"$", "Max": "$sMax; format="python"$", "type": type("SeqOf_type", (object,), {
    $sChild$
})
>>


RefTypeMinMax(sMin, sMax, sName, sModName, sCName, sCModName, bFixedSize, soResolvedType) ::= <<
"kind": "ReferenceType", "ReferencedTypeName": "$sName; format="python"$", "Min": "$sMin; format="python"$", "Max": "$sMax; format="python"$"$if(sModName)$, "ReferencedModName": "$sModName; format="python"$"$endif$
>>


RefType(sName, sModName, sCName, sCModName, soResolvedType) ::= <<
"kind": "ReferenceType", "ReferencedTypeName": "$sName; format="python"$"$if(sModName)$, "ReferencedModName": "$sModName; format="python"$"$endif$
>>

/* Possible additional information generated after the type itself */
Contract(sTypePattern, sExpr) ::= ""
TypePatternCommonTypes() ::= ""
TypePatternSequence(sName, sCName, arrsChildren) ::= ""
SequencePatternChild(sName, sCName) ::= ""
ContractExprMinMax(sPattern, sMin, sMax, bFixedSize) ::= ""
ContractExprSize(sPattern, sMin, sMax, bFixedSize) ::= ""
ContractExprSequence(arrsChildren) ::= ""

/* Print Values */
Print_IntegerValue(nVal) ::= "$nVal$"
Print_RealValue(dVal) ::= <<float("$dVal$".replace(',', '.'))>>   /* some locales do not use a dot separator */
Print_StringValue(v) ::= <<"$v; format="python"$">>
Print_TrueValue() ::= "True"
Print_FalseValue() ::= "False"
Print_BitStringValue(v) ::= <<"$v; format="python"$">>
Print_OctetStringValue(arruOctets) ::= <<'$arruOctets; format="X2"$'>>
Print_RefValue(sName) ::= <<"$sName; format="python"$">>
Print_SeqOfValue(arrsValues) ::= <<($arrsValues; separator=", "$)>>
Print_SeqValue_Child(sName, sChildValue) ::= <<"$sName; format="python"$": $sChildValue$>>
Print_SeqValue(arrsValues) ::= <<{$arrsValues; separator=", "$}>>
Print_ChValue(sAltName, sAltValue) ::= <<
{"choice": "$sAltName; format="python"$", "$sAltName; format="python"$": $sAltValue$}
>>
Print_NullValue() ::= "None"

