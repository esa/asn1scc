group rust_body;

rtlModuleName() ::= ""


printSourceFile(sFileNameWithoutExtension, arrsIncludedFiles, arrsAdaUseTypes, arrsUserDefinedFunctions, arrsValueAndTypeAssignments) ::= <<
// Code automatically generated by asn1scc tool
#![allow(non_snake_case, non_upper_case_globals, unused_parens, unused_imports, unused_variables, unused_mut, unused_assignments, dead_code)]
use asn1rust::*;
use crate::<sFileNameWithoutExtension>Def::*;
<arrsIncludedFiles; separator="
">
<if(arrsUserDefinedFunctions)>
/* User defined functions */
<arrsUserDefinedFunctions: {udf|<udf>}; separator="
">

<endif>

<arrsValueAndTypeAssignments: {uv|<uv>}; separator="
">


>>


printTass(arrsAllProcs) ::= <<

<arrsAllProcs; separator="

">

>>
