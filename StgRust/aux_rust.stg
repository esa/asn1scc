group rust_aux;

rtlModuleName() ::= "asn1rust"


PrintMakeFile(arrsFilesNoExt, bWordSize4, bFpWordSize4, bAsn1sccStreaming) ::= <<
# Rust build file generated by asn1scc
# Build: make
# Run tests: make test
# Coverage: make coverage

RUSTC=rustc
CARGO=cargo

# The source files (Rust modules)
SRC = $(shell echo *.rs)

# Build the project using cargo
all:
	$(CARGO) build

# Run tests
test:
	$(CARGO) test

# Run with coverage (requires tarpaulin or similar)
coverage:
	$(CARGO) tarpaulin --ignore-tests

# Clean build artifacts
clean:
	$(CARGO) clean
	rm -f *.gcda *.gcno *.gcov
>>


emitVisualStudioSolution() ::= ""


PrintCargoToml(sCrateName, arrsFilesNoExt) ::= <<
[package]
name = "<sCrateName>"
version = "0.1.0"
edition = "2021"

[dependencies]
asn1rust = { path = "asn1rust" }

[[bin]]
name = "mainprogram"
path = "mainprogram.rs"

[profile.release]
opt-level = 3
>>
