oct_sqf_null_terminated_encode(p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, arruNullBytes, nBitPatternLength, sErrCode, nIntItemMinSize, nIntItemMaxSize, sType) ::= <<
<loopFixedItem(i=i, sInternalItem=sInternalItem, fixedSize=[p, sAcc, "n_count"])>
{
    let null_bytes: [u8; <length(arruNullBytes)>] = [<arruNullBytes; separator=", ">];
    pBitStrm.append_bits(&null_bytes, <nBitPatternLength>);
}
>>

oct_sqf_null_terminated_decode(p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, arruNullBytes, nBitPatternLength, sErrCode, nIntItemMinSize, nIntItemMaxSize, sType) ::= <<
<i> = 0;
ret = true;
let mut check_bit_pattern_present_result: i32 = 0;
while ret && <i> \< <nSizeMax> && {
    let null_bytes: [u8; <length(arruNullBytes)>] = [<arruNullBytes; separator=", ">];
    check_bit_pattern_present_result = pBitStrm.check_bit_pattern_present(&null_bytes, <nBitPatternLength> as usize);
    check_bit_pattern_present_result == 1
} {
    <sInternalItem>
    <i> += 1;
}

if ret && (<i> == <nSizeMax>) && (check_bit_pattern_present_result == 1) {
    let null_bytes: [u8; <length(arruNullBytes)>] = [<arruNullBytes; separator=", ">];
    check_bit_pattern_present_result = pBitStrm.check_bit_pattern_present(&null_bytes, <nBitPatternLength> as usize);
}


if ret && (check_bit_pattern_present_result == 0) {
    ret = false;            /*COVERAGE_IGNORE*/
    *pErrCode = <sErrCode>;	/*COVERAGE_IGNORE*/
} else if ret && (check_bit_pattern_present_result == 2) {
    <p><sAcc>n_count = <i> as i32;
    ret = true;
    *pErrCode = 0;
}

>>

/* ------------------------------------------------------------------------- */
/* 'size deduced' (Docs/deduced-size-spec.md): the element count is not      */
/* encoded; the decoder derives it from the remaining bits of the enclosing  */
/* decoding region.  Region end = end of the bitstream view minus the        */
/* compile-time trailing constant (nTrailingBits).                           */
/* ------------------------------------------------------------------------- */

str_ascii_deduced_encode(p, sErrCode, nAsn1Max, nTrailingBits, sType) ::= "acn::acn_enc_string_ascii_external_field_determinant(pBitStrm, <nAsn1Max>, &(<p>).arr);"
str_ascii_deduced_decode(p, sErrCode, nAsn1Max, nTrailingBits, sType) ::= <<
{
    let ded_avail_bits = (pBitStrm.count * 8 - <nTrailingBits>) - (pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64);
    let ded_count = ded_avail_bits / 8;
    ret = (ded_avail_bits \>= 0) && (ded_count \<= <nAsn1Max> as i64);
    <A(sErrCode)>
    if ret {
        ret = acn::acn_dec_string_ascii_external_field_determinant(pBitStrm, <nAsn1Max>, ded_count as i64, &mut (<p>).arr);
        <A(sErrCode)>
    }
}
>>

oct_deduced_encode(sTypedefName, p, sAcc, noSizeMin, nSizeMax, nTrailingBits, sErrCode) ::= <<
ret = pBitStrm.octet_string_encode_no_length(&<p><sAcc>arr, <p><sAcc>n_count as usize);
>>

oct_deduced_decode(sTypedefName, p, sAcc, noSizeMin, nSizeMax, nTrailingBits, sErrCode) ::= <<
{
    let ded_avail_bits = (pBitStrm.count * 8 - <nTrailingBits>) - (pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64);
    let ded_count = ded_avail_bits / 8;
    ret = (ded_avail_bits \>= 0) && <if(noSizeMin)>(<noSizeMin> as i64 \<= ded_count) && <endif>(ded_count \<= <nSizeMax> as i64);
    <A(sErrCode)>
    if ret {
        <p><sAcc>n_count = ded_count as i32;
        ret = pBitStrm.octet_string_decode_no_length(&mut <p><sAcc>arr, <p><sAcc>n_count as usize);
        <A(sErrCode)>
    }
}
>>

sqf_deduced_fix_elem_encode(sTypeDefName, p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, nTrailingBits, nIntItemSize, sErrCode) ::= <<
<loopFixedItem(i=i, sInternalItem=sInternalItem, fixedSize=[p, sAcc, "n_count"])>
>>

sqf_deduced_fix_elem_decode(sTypeDefName, p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, nTrailingBits, nIntItemSize, sErrCode) ::= <<
{
    let ded_avail_bits = (pBitStrm.count * 8 - <nTrailingBits>) - (pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64);
    let ded_count = ded_avail_bits / <nIntItemSize>;
    ret = (ded_avail_bits \>= 0) && (ded_avail_bits - ded_count * <nIntItemSize> \< 8) && <if(noSizeMin)>(<noSizeMin> as i64 \<= ded_count) && <endif>(ded_count \<= <nSizeMax> as i64);
    <A(sErrCode)>
    if ret {
        <p><sAcc>n_count = ded_count as i32;
        <loopFixedItem(i=i, sInternalItem=sInternalItem, fixedSize=[p, sAcc, "n_count"])>
    }
}
>>

sqf_deduced_var_elem_encode(sTypeDefName, p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, nTrailingBits, nIntItemMinSize, sErrCode) ::= <<
<loopFixedItem(i=i, sInternalItem=sInternalItem, fixedSize=[p, sAcc, "n_count"])>
>>

sqf_deduced_var_elem_decode(sTypeDefName, p, sAcc, i, sInternalItem, noSizeMin, nSizeMax, nTrailingBits, nIntItemMinSize, sErrCode) ::= <<
{
    let ded_budget_end = pBitStrm.count * 8 - <nTrailingBits>;
    let mut ded_pos = pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64;
    <i> = 0;
    ret = (ded_pos \<= ded_budget_end);
    <A(sErrCode)>
    while ret && <i> \< <nSizeMax> as usize && ded_pos + <nIntItemMinSize> as i64 \<= ded_budget_end
    {
        <sInternalItem>
        ded_pos = pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64;
        if ret && ded_pos \> ded_budget_end {
            ret = false;            /*COVERAGE_IGNORE*/
            *pErrCode = <sErrCode>;	/*COVERAGE_IGNORE*/
        }
        <i> += 1;
    }
    if ret {
        <p><sAcc>n_count = <i> as i32;
        if (ded_budget_end - ded_pos \>= 8)<if(noSizeMin)> || (<i> \< <noSizeMin> as usize)<endif> {
            ret = false;            /*COVERAGE_IGNORE*/
            *pErrCode = <sErrCode>;	/*COVERAGE_IGNORE*/
        }
    }
}
>>



bit_string_external_field_encode(sTypeDefName, p, sErrCode, sAcc, noSizeMin, noSizeMax, sExtFld) ::= <<
pBitStrm.append_bits(&<p><sAcc>arr, <p><sAcc>n_count);
>>

bit_string_external_field_decode(sTypeDefName, p, sErrCode, sAcc, noSizeMin, noSizeMax, sExtFld) ::= <<
<if(noSizeMin)>
ret = (<noSizeMin> \<= <sExtFld><if(noSizeMax)> && <sExtFld> \<= <noSizeMax><endif>);
if ret {
    <p><sAcc>n_count = <sExtFld> as i32;
    ret = pBitStrm.read_bits(&mut <p><sAcc>arr, <p><sAcc>n_count);
    *pErrCode = if ret { 0 } else { <sErrCode> };
}
<else>
<if(noSizeMax)>
ret = (<sExtFld> \<= <noSizeMax>);
if ret {
    <p><sAcc>n_count = <sExtFld> as i32;
    ret = pBitStrm.read_bits(&mut <p><sAcc>arr, <p><sAcc>n_count);
    *pErrCode = if ret { 0 } else { <sErrCode> };
}
<else>
<p><sAcc>n_count = <sExtFld> as i32;
ret = pBitStrm.read_bits(&mut <p><sAcc>arr, <p><sAcc>n_count);
*pErrCode = if ret { 0 } else { <sErrCode> };
<endif>
<endif>
>>

bit_string_external_field_fixed_size_encode(sTypeDefName, p, sErrCode, sAcc, noSizeMin, nSizeMax, sExtFld) ::= <<
pBitStrm.append_bits(&<p><sAcc>arr, <nSizeMax>);
>>

bit_string_external_field_fixed_size_decode(sTypeDefName, p, sErrCode, sAcc, noSizeMin, nSizeMax, sExtFld) ::= <<
ret = (<if(noSizeMin)>(<noSizeMin> \<= <sExtFld>) && <endif>(<sExtFld> \<= <nSizeMax>));
if ret {
    ret = pBitStrm.read_bits(&mut <p><sAcc>arr, <nSizeMax>);
    *pErrCode = if ret { 0 } else { <sErrCode> };
}
>>

bit_string_null_terminated_encode(sTypeDefName, p, sErrCode, sAcc, i, noSizeMin, nSizeMax, arruNullBytes, nBitPatternLength, bFixedSize) ::= <<
pBitStrm.append_bits(&<p><sAcc>arr, <p><sAcc>n_count);
{
    let null_bytes: [u8; <length(arruNullBytes)>] = [<arruNullBytes; separator=", ">];
    pBitStrm.append_bits(&null_bytes, <nBitPatternLength>);
}
>>

bit_string_null_terminated_decode(sTypeDefName, p, sErrCode, sAcc, i, noSizeMin, nSizeMax, arruNullBytes, nBitPatternLength, bFixedSize) ::= <<
{
    let null_bytes: [u8; <length(arruNullBytes)>] = [<arruNullBytes; separator=", ">];
    let (n, ok) = pBitStrm.read_bits_nullterminated(&null_bytes, <nBitPatternLength> as usize, &mut <p><sAcc>arr, <nSizeMax> as i32);
    <p><sAcc>n_count = n as i32;
    ret = ok;
}
*pErrCode = if ret { 0 } else { <sErrCode> };
>>



