
group rust_acn;


getStringSize(p) ::= "<p>.len() as _"

getSizeableSize(p, sAcc, bIsUnsigned) ::= "<p><sAcc>n_count as _"


EmitTypeAssignment_def_err_code(sErrCode, nErrValue, soErrorCodeComment, sFieldPath) ::= <<
pub const <sErrCode>: i32 = <nErrValue>;  /*<soErrorCodeComment>*/
>>

EmitAcnParameter(sName, sType, sDefaultValue) ::= "<sType>, <sName>"

EmitEncodingSizeConstants(sTypeDefName, nMaxBytesInACN, nMaxBitsInACN) ::= <<
pub const <sTypeDefName>_REQUIRED_BYTES_FOR_ACN_ENCODING: usize = <nMaxBytesInACN>;
pub const <sTypeDefName>_REQUIRED_BITS_FOR_ACN_ENCODING: usize = <nMaxBitsInACN>;
>>



EmitTypeAssignment_primitive_def_encode(sVarName, sStar, sFuncName, sTypeDefName, arrsErrcodes, bEmptyEncodingSpace, nMaxBytesInACN, nMaxBitsInACN, arrsAcnPrms, soSparkAnnotations) ::= <<
<arrsErrcodes; separator="\n">
>>

EmitTypeAssignment_primitive_encode(sVarName, sStar, sFuncName, soIValidFuncName, sTypeDefName, arrsLocalVariables, sContent, soSparkAnnotations, sInitialExp, arrsAcnPrms, arrsAcnParamNames, bEmptyEncodingSpace, bBsIsUnreferenced, bVarNameIsUnreferenced, bHasAcnChildrenToReturn, soInitFuncName, arrsAnnots, arrsPrecond, arrsPostcond) ::= <<
pub fn <sFuncName>(<sVarName>: &<sTypeDefName><sStar>, pBitStrm: &mut BitStream, pErrCode: &mut i32, bCheckConstraints: bool<if(arrsAcnPrms)>, <arrsAcnPrms; separator=", "><endif>) -> bool {
    let mut ret: bool = true;
<if(bVarNameIsUnreferenced)>
    let _ = <sVarName>;

<endif>
<if(bBsIsUnreferenced)>
    let _ = pBitStrm;

<endif>

    <arrsLocalVariables:{lv|<lv>}; separator="\n">
    <if(soIValidFuncName)>
    *pErrCode = 0;
    ret = if bCheckConstraints { <soIValidFuncName>(<sVarName>, pErrCode) } else { true };
    if ret && *pErrCode == 0 {
        <sContent>
    } /*COVERAGE_IGNORE*/

    <else>
    *pErrCode = 0;
    let _ = bCheckConstraints;

    <sContent>

    <endif>

    ret
}
>>

EmitTypeAssignment_primitive_def_decode(sVarName, sStar, sFuncName, sTypeDefName, arrsErrcodes, bEmptyEncodingSpace, nMaxBytesInACN, nMaxBitsInACN, arrsAcnPrms, soSparkAnnotations) ::= <<
<arrsErrcodes; separator="\n">
>>

EmitTypeAssignment_primitive_decode(sVarName, sStar, sFuncName, soIValidFuncName, sTypeDefName, arrsLocalVariables, sContent, soSparkAnnotations, sInitialExp, arrsAcnPrms, arrsAcnParamNames, bEmptyEncodingSpace, bBsIsUnreferenced, bVarNameIsUnreferenced, bHasAcnChildrenToReturn, soInitFuncName, arrsAnnots, arrsPrecond, arrsPostcond) ::= <<
pub fn <sFuncName>(<sVarName>: &mut <sTypeDefName><sStar>, pBitStrm: &mut BitStream, pErrCode: &mut i32<if(arrsAcnPrms)>, <arrsAcnPrms; separator=", "><endif>) -> bool {
    let mut ret: bool = true;
<if(bVarNameIsUnreferenced)>
    let _ = <sVarName>;

<endif>
<if(bBsIsUnreferenced)>
    let _ = pBitStrm;

<endif>
    *pErrCode = 0;

    <arrsLocalVariables:{lv|<lv>}; separator="\n">

    <sContent>

    ret<if(soIValidFuncName)> && <soIValidFuncName>(<sVarName>, pErrCode)<endif>
}
>>










A(sErrCode) /*nogen*/ ::= "*pErrCode = if ret { 0 } else { <sErrCode> };"

MF(soMF) /*nogen*/ ::= <<
<if(soMF)>
if ret {
    <p> = <soMF>_decode(<p>);
}

<endif>
>>

MappingFunctionDeclaration_encode(sTypeName, sMF) ::= "/* extern <sTypeName> <sMF>_encode(<sTypeName>); */"

MappingFunctionDeclaration_decode(sTypeName, sMF) ::= "/* extern <sTypeName> <sMF>_decode(<sTypeName>); */"



loopFixedItem (i, fixedSize,  sInternalItem)::= /*nogen*/<<
let mut <i>: usize = 0;
while <i> \< (<fixedSize> as usize) && ret {
    <sInternalItem>
    <i> += 1;
}
>>



alignToNext_encode(sMainBody, sAlignmentValue, nAlignmentValue, nAbsOffset, nRemainingMinBits, nLevel, nIx, nOffset) ::= <<
acn::acn_align_to<sAlignmentValue>(pBitStrm, true);
<sMainBody>
>>


alignToNext_decode(sMainBody, sAlignmentValue, nAlignmentValue, nAbsOffset, nRemainingMinBits, nLevel, nIx, nOffset) ::= <<
acn::acn_align_to<sAlignmentValue>(pBitStrm, false);
<sMainBody>
>>



