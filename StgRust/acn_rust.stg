/* Extra formal parameter for a function receiving a deferred determinant */
acn_deferred_det_formal_param_encode(sDetName) ::= "<sDetName>: &mut acn::AcnInsertedFieldRef"
acn_deferred_det_formal_param_decode(sDetName) ::= "<sDetName>: &mut acn::AcnInsertedFieldRef"

/* Pass a deferred determinant as actual parameter in a function call */
acn_deferred_det_actual_param_encode(sDetName) ::= "&mut <sDetName>"
acn_deferred_det_actual_param_decode(sDetName) ::= "&mut <sDetName>"

/* Save current bitstream position */
acn_deferred_det_save_pos_encode(sVarName) ::= "let <sVarName> = acn::acn_bit_stream_get_pos(pBitStrm);"
acn_deferred_det_save_pos_decode(sVarName) ::= "let <sVarName> = acn::acn_bit_stream_get_pos(pBitStrm);"

/* Compute distance in bytes between two positions */
acn_deferred_det_distance_bytes_encode(sStart, sEnd) ::= "acn::acn_bit_stream_distance_in_bytes(<sStart>, <sEnd>)"
acn_deferred_det_distance_bytes_decode(sStart, sEnd) ::= "acn::acn_bit_stream_distance_in_bytes(<sStart>, <sEnd>)"

/* ========================================================================
   ACN Deferred Patching — Value Expression & Structural Templates
   ======================================================================== */

/* Group A: PatchDet value expressions (codec-independent) */

/* CHOICE kind field access */
acn_deferred_det_kind_access(p, sAcc) ::= "<p><sAcc>kind"

/* Presence-bool value expression: (parent->exist.child == 1) */
acn_deferred_det_value_presence_bool(p, sAcc, sChildName) ::= "(<p><sAcc>exist.<sChildName>)"

/* Switch case item for integer/enum presence or choice determinant */
acn_deferred_det_switch_case_int(sCaseName, sVarName, sValue) ::= "    <sCaseName>(..) => { <sVarName> = <sValue>; }"

/* Full switch block for integer presence or choice determinant */
acn_deferred_det_switch_int(sVarName, sKindAccess, arrsCaseItems) ::= <<
let mut <sVarName>: u64;
match <sKindAccess> {
<arrsCaseItems; separator="\n">
    _ => { ret = false; } /*COVERAGE_IGNORE*/
}
if !ret { return false; }
>>

/* Switch case item for string presence */
acn_deferred_det_switch_case_str(sCaseName, sVarName, sValue) ::= <<    <sCaseName>(..) => { <sVarName> = "<sValue>"; }>>

/* Full switch block for string presence */
acn_deferred_det_switch_str(sVarName, sKindAccess, arrsCaseItems) ::= <<
let mut <sVarName>: &str;
match <sKindAccess> {
<arrsCaseItems; separator="\n">
    _ => { ret = false; } /*COVERAGE_IGNORE*/
}
if !ret { return false; }
>>

/* Group B: Fallback PatchDet (encode-only, decode is empty) */

/* Fallback patch without nBits */
acn_deferred_det_fallback_value_encode(sPatchFuncName, sDefaultVal, sDetName) ::= <<
if !<sDetName>.is_set {
    <sPatchFuncName>(<sDefaultVal> as u64, pBitStrm, &mut <sDetName>, pErrCode); /*COVERAGE_IGNORE*/
}
>>
acn_deferred_det_fallback_value_decode(sPatchFuncName, sDefaultVal, sDetName) ::= ""

/* Fallback patch with nBits */
acn_deferred_det_fallback_value_with_size_encode(sPatchFuncName, sDefaultVal, nBits, sDetName) ::= <<
if !<sDetName>.is_set {
    <sPatchFuncName>(<sDefaultVal> as u64, pBitStrm, <nBits>, &mut <sDetName>, pErrCode); /*COVERAGE_IGNORE*/
}
>>
acn_deferred_det_fallback_value_with_size_decode(sPatchFuncName, sDefaultVal, nBits, sDetName) ::= ""

/* Fallback patch for IA5String */
acn_deferred_det_fallback_value_str_encode(sPatchFuncName, sDefaultVal, nBits, sDetName) ::= <<
if !<sDetName>.is_set {
    <sPatchFuncName>(<sDefaultVal>, pBitStrm, <nBits>, &mut <sDetName>, pErrCode); /*COVERAGE_IGNORE*/
}
>>
acn_deferred_det_fallback_value_str_decode(sPatchFuncName, sDefaultVal, nBits, sDetName) ::= ""

/* Group C: Decode redirect */

/* Assignment after temp-variable decode: det.value = (asn1SccUint)tmp; */
acn_deferred_det_copy_tmp_encode(sDetAccess, sTmpName) ::= ""
acn_deferred_det_copy_tmp_decode(sDetAccess, sTmpName) ::= "<sDetAccess> = <sTmpName> as u64;"

/* Boolean tmp variant — C cast works as for int.  Kept as a distinct macro so
   strongly-typed backends (Ada) can emit a different conversion. */
acn_deferred_det_copy_bool_tmp_encode(sDetAccess, sTmpName) ::= ""
acn_deferred_det_copy_bool_tmp_decode(sDetAccess, sTmpName) ::= "<sDetAccess> = <sTmpName> as u64;"

/* Enum tmp variant — same C output as int (enum→uint is implicit).  The
   sEnumTypeName parameter is unused in C; Ada needs it for 'Enum_Rep. */
acn_deferred_det_copy_enum_tmp_encode(sDetAccess, sTmpName, sEnumTypeName) ::= ""
acn_deferred_det_copy_enum_tmp_decode(sDetAccess, sTmpName, sEnumTypeName) ::= "<sDetAccess> = <sTmpName> as u64;"

/* Group D: Access paths (codec-independent) */

/* Local det value access: det.value */
acn_deferred_det_access_value(sDetName) ::= "<sDetName>.value"

/* Pointer det value access: det->value */
acn_deferred_det_access_ptr(sDetName) ::= "<sDetName>.value"

/* Pointer det value access used as a boolean (e.g. for present-when bool deps).
   In C, det->value is truthy as-is; emit the same expression to preserve byte
   identity with the existing _ptr access. */
acn_deferred_det_access_bool_ptr(sDetName) ::= "<sDetName>.value"

/* Local det string value access: det.str_value */
acn_deferred_det_access_str_value(sDetName) ::= "<sDetName>.str_value"

/* Pointer det string value access: det->str_value */
acn_deferred_det_access_str_ptr(sDetName) ::= "<sDetName>.str_value"

/* Struct field access via pointer: rootId->field.field */
acn_deferred_det_relative_access(sRootId, sFieldPath) ::= "<sRootId>.<sFieldPath>"

/* Group E: Miscellaneous */

/* UPER offset subtraction expression */
acn_deferred_det_uper_offset_sub(sValue, sOffset) ::= "(<sValue> - <sOffset>)"

/* Wrap a preBlock and patchCall in braces */
acn_deferred_det_preblock_wrap(sPreBlock, sPatchCall) ::= <<
{
<sPreBlock>
<sPatchCall>
}
>>

/* AcnInsertedFieldRef type name */
acn_deferred_det_type_name() ::= "acn::AcnInsertedFieldRef"

/* AcnInsertedFieldRef zero initializer */
acn_deferred_det_init_expr() ::= "acn::AcnInsertedFieldRef::default()"
