rtlModuleName() ::= ""
sparkAnnotations_encode(sTypeDefName) ::= ""
sparkAnnotations_decode(sTypeDefName) ::= ""



octet_string_containing_func_encode(p, sFuncName, sContainedType, sReqBytesForAcnEncoding, nBits, nMinSize, nMaxSize, bFixedSize) ::= <<
/*open new scope to declare some variables*/
{
    /*encode to a temporary bitstream*/
    let mut arr: [u8; <sReqBytesForAcnEncoding> as usize] = [0; <sReqBytesForAcnEncoding> as usize];
    let mut bit_strm = BitStream::new(&mut arr);

    ret = <sFuncName>(&<p>, &mut bit_strm, pErrCode, false);
    if ret {
        let n_count = if bit_strm.current_bit == 0 { bit_strm.current_byte as i32 } else { (bit_strm.current_byte + 1) as i32 };
        <if(bFixedSize)>
        ret = pBitStrm.octet_string_encode_no_length(&arr, n_count as usize);

        <else>
        pBitStrm.encode_constraint_whole_number(n_count as i64, <nMinSize> as i64, <nMaxSize> as i64);
        ret = pBitStrm.octet_string_encode_no_length(&arr, n_count as usize);

        <endif>
    }
}
>>

octet_string_containing_func_decode(p, sFuncName, sContainedType, sReqBytesForAcnEncoding, nBits, nMinSize, nMaxSize, bFixedSize) ::= <<
/*open new scope to declare some variables*/
{
    /*decode to a temporary bitstream whose view is limited to the actual
      region size ('size deduced' support)*/
    let mut arr: [u8; <sReqBytesForAcnEncoding> as usize] = [0; <sReqBytesForAcnEncoding> as usize];

    <if(bFixedSize)>
    ret = pBitStrm.octet_string_decode_no_length(&mut arr, <nMinSize> as usize);
    if ret {
        let mut bit_strm = BitStream::attach_buffer_no_zero(&mut arr[..<nMinSize> as usize]);
        ret = <sFuncName>(&mut <p>, &mut bit_strm, pErrCode);
    }

    <else>
    let mut n_count: i64;
    let (val, ok) = pBitStrm.decode_constraint_whole_number(<nMinSize> as i64, <nMaxSize> as i64);
    n_count = val;
    ret = ok;
    if ret {
        ret = pBitStrm.octet_string_decode_no_length(&mut arr, n_count as usize);
        if ret {
            let mut bit_strm = BitStream::attach_buffer_no_zero(&mut arr[..n_count as usize]);
            ret = <sFuncName>(&mut <p>, &mut bit_strm, pErrCode);
        }
    }

    <endif>
}
>>

bit_string_containing_func_encode(p, sFuncName, sContainedType, sReqBytesForAcnEncoding, sReqBitsForUperEncoding, nBits, nMinSize, nMaxSize, bFixedSize) ::= <<
/*open new scope to declare some variables*/
{
    /*encode to a temporary bitstream*/
    let mut arr: [u8; <sReqBytesForAcnEncoding> as usize] = [0; <sReqBytesForAcnEncoding> as usize];
    let mut bit_strm = BitStream::new(&mut arr);

    ret = <sFuncName>(&<p>, &mut bit_strm, pErrCode, false);
    if ret {
        let n_count = (bit_strm.current_byte * 8 + bit_strm.current_bit as i64) as i32;
        <if(bFixedSize)>
        pBitStrm.append_bits(&arr, n_count);

        <else>
        pBitStrm.encode_constraint_whole_number(n_count as i64, <nMinSize> as i64, <nMaxSize> as i64);
        pBitStrm.append_bits(&arr, n_count);

        <endif>


    }
}
>>

bit_string_containing_func_decode(p, sFuncName, sContainedType, sReqBytesForAcnEncoding, sReqBitsForUperEncoding, nBits, nMinSize, nMaxSize, bFixedSize) ::= <<
/*open new scope to declare some variables*/
{
    /*decode to a temporary bitstream*/
    let mut arr: [u8; <sReqBytesForAcnEncoding> as usize] = [0; <sReqBytesForAcnEncoding> as usize];

    <if(bFixedSize)>
    ret = pBitStrm.read_bits(&mut arr, <nMinSize>);
    if ret {
        let mut bit_strm = BitStream::attach_buffer_no_zero(&mut arr[..<sReqBytesForAcnEncoding> as usize]);
        ret = <sFuncName>(&mut <p>, &mut bit_strm, pErrCode);
    }

    <else>
    let mut n_count: i64;
    let (val, ok) = pBitStrm.decode_constraint_whole_number(<nMinSize> as i64, <nMaxSize> as i64);
    n_count = val;
    ret = ok;
    if ret {
        ret = pBitStrm.read_bits(&mut arr, n_count as i32);
        if ret {
            let mut bit_strm = BitStream::attach_buffer_no_zero(&mut arr[..<sReqBytesForAcnEncoding> as usize]);
            ret = <sFuncName>(&mut <p>, &mut bit_strm, pErrCode);
        }
    }

    <endif>
}
>>


/* ========================================================================
   ACN Deferred Patching Templates
   Used when --acn-deferred flag is enabled.
   ======================================================================== */

/* Declare an AcnInsertedFieldRef local variable */
acn_deferred_det_declare_encode(sDetName) ::= "let mut <sDetName>: acn::AcnInsertedFieldRef = acn::AcnInsertedFieldRef::default();"
acn_deferred_det_declare_decode(sDetName) ::= "let mut <sDetName>: acn::AcnInsertedFieldRef = acn::AcnInsertedFieldRef::default();"

/* Reserve space in the bitstream (calls Acn_InitDet_XXX).
   "value" variant: det is a local AcnInsertedFieldRef variable — pass address.
   "ptr" variant: det is an AcnInsertedFieldRef* formal parameter — pass as-is. */
acn_deferred_det_init_value_encode(sInitFuncName, sDetName) ::= <<
<sInitFuncName>(pBitStrm, &mut <sDetName>);
>>
acn_deferred_det_init_value_decode(sInitFuncName, sDetName) ::= <<
/* decode: no init needed */
>>
acn_deferred_det_init_ptr_encode(sInitFuncName, sDetName) ::= <<
<sInitFuncName>(pBitStrm, <sDetName>);
>>
acn_deferred_det_init_ptr_decode(sInitFuncName, sDetName) ::= <<
/* decode: no init needed */
>>

/* Patch the value at the saved position (calls Acn_PatchDet_XXX) */
/* "value" variant: det is a local AcnInsertedFieldRef variable — pass address.
   "ptr" variant: det is an AcnInsertedFieldRef* formal parameter — pass as-is. */
acn_deferred_det_patch_value_encode(sPatchFuncName, sValue, sDetName, sErrCode) ::= <<
ret = <sPatchFuncName>(<sValue> as u64, pBitStrm, &mut <sDetName>, pErrCode);
*pErrCode = <sErrCode>;
if !ret { return false; }
>>
acn_deferred_det_patch_value_decode(sPatchFuncName, sValue, sDetName, sErrCode) ::= <<
/* decode: no patch needed */
>>
acn_deferred_det_patch_ptr_encode(sPatchFuncName, sValue, sDetName, sErrCode) ::= <<
ret = <sPatchFuncName>(<sValue> as u64, pBitStrm, <sDetName>, pErrCode);
*pErrCode = <sErrCode>;
if !ret { return false; }
>>
acn_deferred_det_patch_ptr_decode(sPatchFuncName, sValue, sDetName, sErrCode) ::= <<
/* decode: no patch needed */
>>

/* _with_size variants: InitDet/PatchDet for arbitrary bit widths (nBits parameter) */
acn_deferred_det_init_value_with_size_encode(sInitFuncName, nBits, sDetName) ::= <<
<sInitFuncName>(pBitStrm, <nBits>, &mut <sDetName>);
>>
acn_deferred_det_init_value_with_size_decode(sInitFuncName, nBits, sDetName) ::= <<
/* decode: no init needed */
>>

acn_deferred_det_init_ptr_with_size_encode(sInitFuncName, nBits, sDetName) ::= <<
<sInitFuncName>(pBitStrm, <nBits>, <sDetName>);
>>
acn_deferred_det_init_ptr_with_size_decode(sInitFuncName, nBits, sDetName) ::= <<
/* decode: no init needed */
>>

acn_deferred_det_patch_value_with_size_encode(sPatchFuncName, nBits, sValue, sDetName, sErrCode) ::= <<
ret = <sPatchFuncName>(<sValue> as u64, pBitStrm, <nBits>, &mut <sDetName>, pErrCode);
*pErrCode = <sErrCode>;
if !ret { return false; }
>>
acn_deferred_det_patch_value_with_size_decode(sPatchFuncName, nBits, sValue, sDetName, sErrCode) ::= <<
/* decode: no patch needed */
>>

acn_deferred_det_patch_ptr_with_size_encode(sPatchFuncName, nBits, sValue, sDetName, sErrCode) ::= <<
ret = <sPatchFuncName>(<sValue> as u64, pBitStrm, <nBits>, <sDetName>, pErrCode);
*pErrCode = <sErrCode>;
if !ret { return false; }
