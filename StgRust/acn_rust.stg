    <sUpdateStatement>
}
>>


SizeDependency_oct_str_containing(p, sFuncName, sReqBytesForUperEncoding, v, bIsOctet, sInner, sLocalVarType) ::= <<
{
    /*first encode containing type to a temporary bitstream. That's the only way to learn in advance the size of the encoding octet string*/
    arr = [0u8; <sReqBytesForUperEncoding>];
    bit_strm = BitStream::new(&mut arr);
    {
        let pBitStrm = &mut bit_strm;
        <sInner>
    }
}
if ret {
    <v> = (<if(bIsOctet)>if bit_strm.current_bit == 0 { bit_strm.current_byte } else { bit_strm.current_byte + 1 }<else>bit_strm.current_byte * 8 + bit_strm.current_bit as i64<endif>) as <sLocalVarType>;
    <v>_is_initialized = true;
}

>>


octet_string_containing_ext_field_func_encode(p, sFuncName, sReqBytesForUperEncoding, sExtField, sErrCode, soInner) ::= <<
ret = pBitStrm.octet_string_encode_no_length(&arr, <sExtField> as usize);
>>

octet_string_containing_ext_field_func_decode(p, sFuncName, sReqBytesForUperEncoding, sExtField, sErrCode, soInner) ::= <<
/*open new scope to declare some variables*/
{
    let mut arr: [u8; <sReqBytesForUperEncoding> as usize] = [0; <sReqBytesForUperEncoding> as usize];
    /*limit the temporary stream view to the actual region size ('size deduced' support)*/
    ret = (<sExtField> as i64 \<= <sReqBytesForUperEncoding> as i64);
    *pErrCode = if ret { 0 } else { <sErrCode> };
    if ret {
        /*decode to the temporary bitstream buffer */
        ret = pBitStrm.octet_string_decode_no_length(&mut arr, <sExtField> as usize);
        <A(sErrCode)>
        if ret {
            let mut bit_strm = BitStream::attach_buffer_no_zero(&mut arr[..<sExtField> as usize]);
            let pBitStrm = &mut bit_strm;
            <soInner>
        }
    }
}
>>

/* CONTAINING with deferred patching: encode directly, PatchDet with measured distance */
octet_string_containing_deferred_func_encode(p, sFuncName, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_data_start = acn::acn_bit_stream_get_pos(pBitStrm);
    ret = <sFuncName>(&<p>, pBitStrm, pErrCode, false);
    if ret {
        /*pad the contained encoding to the next byte boundary: the region is
          measured in whole octets and the decoder resumes at a byte boundary*/
        if pBitStrm.current_bit != 0 {
            pBitStrm.append_n_bit_zero(8 - pBitStrm.current_bit); /*COVERAGE_IGNORE*/
        }
        let acn_data_end = acn::acn_bit_stream_get_pos(pBitStrm);
        let acn_n_count = acn::acn_bit_stream_distance_in_bytes(acn_data_start, acn_data_end);
        ret = <sPatchFuncName>(acn_n_count, pBitStrm, <sDetParamName>, pErrCode);
        *pErrCode = <sErrCode>;
        if !ret { return false; }
    }
}
>>

/* CONTAINING with deferred patching: limit stream view, decode directly */
octet_string_containing_deferred_func_decode(p, sFuncName, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_saved_count = pBitStrm.count;
    let acn_expected_end = pBitStrm.current_byte + <sDetParamName>.value as i64;
    pBitStrm.count = acn_expected_end;
    ret = <sFuncName>(&mut <p>, pBitStrm, pErrCode);
    pBitStrm.count = acn_saved_count;
    pBitStrm.current_byte = acn_expected_end;
    pBitStrm.current_bit = 0;
}
>>

/* CONTAINING with deferred patching, FIXED_SIZE: just call directly, no temp buffer */
octet_string_containing_deferred_fixed_func_encode(p, sFuncName) ::= <<
ret = <sFuncName>(&<p>, pBitStrm, pErrCode, false);
>>

octet_string_containing_deferred_fixed_func_decode(p, sFuncName) ::= <<
ret = <sFuncName>(&mut <p>, pBitStrm, pErrCode);
>>

/* CONTAINING with deferred patching, LENGTH_EMBEDDED: save_pos + placeholder + direct encode + measure + patch */
octet_string_containing_deferred_embedded_func_encode(p, sFuncName, nMinSize, nMaxSize, nBits) ::= <<
{
    let acn_len_pos = acn::acn_bit_stream_get_pos(pBitStrm);
    pBitStrm.encode_constraint_whole_number(<nMinSize> as i64, <nMinSize> as i64, <nMaxSize> as i64);
    let acn_data_start = acn::acn_bit_stream_get_pos(pBitStrm);
    ret = <sFuncName>(&<p>, pBitStrm, pErrCode, false);
    if ret {
        /*pad the contained encoding to the next byte boundary (see the
          ext-field variant above)*/
        if pBitStrm.current_bit != 0 {
            pBitStrm.append_n_bit_zero(8 - pBitStrm.current_bit); /*COVERAGE_IGNORE*/
        }
        let acn_data_end = acn::acn_bit_stream_get_pos(pBitStrm);
        let acn_n_count = acn::acn_bit_stream_distance_in_bytes(acn_data_start, acn_data_end);
        acn::acn_bit_stream_set_pos(pBitStrm, acn_len_pos);
        pBitStrm.encode_constraint_whole_number(acn_n_count as i64, <nMinSize> as i64, <nMaxSize> as i64);
        acn::acn_bit_stream_set_pos(pBitStrm, acn_data_end);
    }
}
>>

octet_string_containing_deferred_embedded_func_decode(p, sFuncName, nMinSize, nMaxSize, nBits) ::= <<
{
    let (acn_n_count, ok) = pBitStrm.decode_constraint_whole_number(<nMinSize> as i64, <nMaxSize> as i64);
    ret = ok;
    if ret {
        let acn_saved_count = pBitStrm.count;
        let acn_expected_end = pBitStrm.current_byte + acn_n_count;
        pBitStrm.count = acn_expected_end;
        ret = <sFuncName>(&mut <p>, pBitStrm, pErrCode);
        pBitStrm.count = acn_saved_count;
        pBitStrm.current_byte = acn_expected_end;
        pBitStrm.current_bit = 0;
    }
}
>>

/* CONTAINING ExternalField wrapper: wraps an inline body with save-pos/measure/PatchDet
   Used when the contained type has ACN parameters (no standalone ACN function). */
octet_string_containing_deferred_wrapper_encode(sBody, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_data_start = acn::acn_bit_stream_get_pos(pBitStrm);
    <sBody>
    if ret {
        /*pad the contained encoding to the next byte boundary (see the
          ext-field variant above)*/
        if pBitStrm.current_bit != 0 {
            pBitStrm.append_n_bit_zero(8 - pBitStrm.current_bit); /*COVERAGE_IGNORE*/
        }
        let acn_data_end = acn::acn_bit_stream_get_pos(pBitStrm);
        let acn_n_count = acn::acn_bit_stream_distance_in_bytes(acn_data_start, acn_data_end);
        ret = <sPatchFuncName>(acn_n_count, pBitStrm, <sDetParamName>, pErrCode);
        *pErrCode = <sErrCode>;
        if !ret { return false; }
    }
}
>>

octet_string_containing_deferred_wrapper_decode(sBody, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_saved_count = pBitStrm.count;
    let acn_expected_end = pBitStrm.current_byte + <sDetParamName>.value as i64;
    pBitStrm.count = acn_expected_end;
    <sBody>
    pBitStrm.count = acn_saved_count;
    pBitStrm.current_byte = acn_expected_end;
    pBitStrm.current_bit = 0;
}
>>

/* BIT STRING CONTAINING with deferred patching: encode directly, PatchDet with measured bit distance */
bit_string_containing_deferred_func_encode(p, sFuncName, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_data_start = acn::acn_bit_stream_get_pos(pBitStrm);
    ret = <sFuncName>(<p>, pBitStrm, pErrCode, false);
    if ret {
        let acn_data_end = acn::acn_bit_stream_get_pos(pBitStrm);
        let acn_n_count = acn::acn_bit_stream_distance_in_bits(acn_data_start, acn_data_end);
        ret = <sPatchFuncName>(acn_n_count, pBitStrm, <sDetParamName>, pErrCode);
        *pErrCode = <sErrCode>;
        if !ret { return false; }
    }
}
>>

/* BIT STRING CONTAINING with deferred patching: limit stream view (bit-granular), decode directly */
bit_string_containing_deferred_func_decode(p, sFuncName, sDetParamName, sPatchFuncName, sErrCode) ::= <<
{
    let acn_start_bits = pBitStrm.current_byte * 8 + pBitStrm.current_bit as i64;
    let acn_end_bits = acn_start_bits + <sDetParamName>.value as i64;
    let acn_saved_count = pBitStrm.count;
    pBitStrm.count = (acn_end_bits + 7) / 8;
    ret = <sFuncName>(<p>, pBitStrm, pErrCode);
    pBitStrm.count = acn_saved_count;
    pBitStrm.current_byte = acn_end_bits / 8;
    pBitStrm.current_bit = (acn_end_bits % 8) as i32;
}
>>

/* BIT STRING CONTAINING with deferred patching, FIXED_SIZE: just call directly, no temp buffer */
bit_string_containing_deferred_fixed_func_encode(p, sFuncName) ::= <<
ret = <sFuncName>(<p>, pBitStrm, pErrCode, false);
>>

