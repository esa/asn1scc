/* IA5String PatchDet variants: pass string value directly (no asn1SccUint cast) */
acn_deferred_det_patch_value_str_encode(sPatchFuncName, nBits, sValue, sDetName, sErrCode) ::= <<
ret = <sPatchFuncName>(<sValue>, pBitStrm, <nBits>, &mut <sDetName>, pErrCode);
*pErrCode = <sErrCode>;
if !ret { return false; }
>>
acn_deferred_det_patch_value_str_decode(sPatchFuncName, nBits, sValue, sDetName, sErrCode) ::= <<
/* decode: no patch needed */
