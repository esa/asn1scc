Define_new_sequence_of(td/*:FE_SizeableTypeDefinition*/, nMin, nMax, bFixedSize, sChildType, soChildDefinition, arrsSizeClassDefinition, arrsSizeObjDefinition, arrsInvariants, arr_Asn1Encoding) ::= <<

<soChildDefinition>

#[repr(C)]
#[derive(Debug, Clone, Copy)]
pub struct <td.typeName> {
<if(!bFixedSize)>
    pub n_count: i32,
<endif>
    pub arr: [<sChildType>; <nMax>],
}

impl Default for <td.typeName> {
    fn default() -> Self {
        <td.typeName> { <if(!bFixedSize)>n_count: 0, <endif>arr: [Default::default(); <nMax>] }
    }
}
>>



