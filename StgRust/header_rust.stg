Define_new_bit_string_named_bit(td/*:FE_SizeableTypeDefinition*/, sTargetLangBitName, sHexValue, sComment) ::= <<
pub const <td.typeName>_<sTargetLangBitName>: u64 = 0x<sHexValue>;  /*<sComment>*/
>>

Define_new_bit_string(td/*:FE_SizeableTypeDefinition*/, nMin, nMax, bFixedSize, nMaxOctets, arrsNamedBits, arrsInvariants, arr_Asn1Encoding) ::= <<
<arrsNamedBits:{it|<it>}; separator="\n">

#[repr(C)]
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct <td.typeName> {
<if(!bFixedSize)>
    pub n_count: i32, /*Number of bits in the array. Max value is : <nMax> */
<endif>
    pub arr: [u8; <nMaxOctets>],
}

impl Default for <td.typeName> {
    fn default() -> Self {
        <td.typeName> { <if(!bFixedSize)>n_count: 0, <endif>arr: [0; <nMaxOctets>] }
    }
}

impl std::ops::Index\<usize\> for <td.typeName> {
    type Output = u8;
    fn index(&self, i: usize) -> &Self::Output {
        &self.arr[i]
    }
}

impl std::ops::IndexMut\<usize\> for <td.typeName> {
    fn index_mut(&mut self, i: usize) -> &mut Self::Output {
        &mut self.arr[i]
    }
}

impl <td.typeName> {
    pub fn len(&self) -> usize {
<if(!bFixedSize)>
        self.n_count as usize
<else>
        self.arr.len()
<endif>
    }
}
>>

