/***********************************       SEQUENCE     ************************************************************/

Define_new_sequence_child_bit(sName) ::= "pub <sName>: bool"

Define_new_sequence_child(sName, sType, bIsOptional) ::= <<
pub <sName>: <sType>
>>

Define_new_sequence_save_pos_child(td/*:FE_SequenceTypeDefinition*/, sName, nMaxBytesInACN) ::= "pub <sName>: BitStream"

Define_new_sequence(td/*:FE_SequenceTypeDefinition*/, arrsChildren, arrsOptionalChildren, arrsChildrenDefinitions, arrsNullFieldsSavePos, arrsSizeDefinition, arrsInvariants, arr_Asn1Encoding) ::= <<
/*-- <td.typeName> --------------------------------------------*/
<arrsChildrenDefinitions; separator= "\n">
<if (arrsNullFieldsSavePos)>
#[repr(C)]
#[derive(Debug, Clone, Copy)]
pub struct <td.extension_function_positions> {
    <arrsNullFieldsSavePos; separator="\n">
}

<endif>
<if(arrsOptionalChildren)>
#[repr(C)]
#[derive(Debug, Clone, Copy, Default)]
pub struct <td.typeName>_exist {
    <arrsOptionalChildren; separator=",\n">
}
<endif>

#[repr(C)]
#[derive(Debug, Clone, Copy, Default)]
pub struct <td.typeName> {
    <if(arrsOptionalChildren)>pub exist: <td.typeName>_exist,<endif>
    <arrsChildren; separator=",\n">
}
>>

Define_subType_sequence(td/*:FE_SequenceTypeDefinition*/, prTd/*:FE_SequenceTypeDefinition*/, soParentTypePackage, arrsOptionalChildren, arrsExtraDefs, arr_Asn1Encoding) ::= <<
pub type <td.typeName> = <prTd.typeName>;
<if (arrsOptionalChildren)>
pub type <td.typeName>_exist = <prTd.typeName>_exist;
<endif>
<if (arrsNullFieldsSavePos)>
pub type <td.extension_function_positions> = <prTd.extension_function_positions>;

<endif>
>>

