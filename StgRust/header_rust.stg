Define_new_enumerated_item(td/*:FE_EnumeratedTypeDefinition*/, sName, nValue) ::= "<sName> = <nValue>"

Define_new_enumerated_item_macro(td/*:FE_EnumeratedTypeDefinition*/, sAsn1Name, sCName) ::= "// pub const <td.typeName>_<sAsn1Name>: <td.typeName> = <td.typeName>::<sCName>;"

Define_new_enumerated(td/*:FE_EnumeratedTypeDefinition*/, arrsEnumNames, arrsEnumNamesAndValues, nIndexMax, arrsResolvingMacros, arr_Asn1Encoding) ::= <<
#[repr(C)]
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum <td.typeName> {
    <arrsEnumNamesAndValues:{it|<it>}; separator=",\n">,
}

// please use the following macros to avoid breaking code.
<arrsResolvingMacros; separator="\n">
>>



Define_subType_enumerated(td/*:FE_EnumeratedTypeDefinition*/, prTd/*:FE_EnumeratedTypeDefinition*/, soParentTypePackage, arr_Asn1Encoding) ::= <<
pub type <td.typeName> = <prTd.typeName>;
>>

Define_new_enumerated_private(td/*:FE_EnumeratedTypeDefinition*/, arrsValidEnumNames, arrsEnumNames) ::= <<
pub static <td.values_array>: &[i64] = &[
    <arrsValidEnumNames:{it|<it>}; separator=", ">
];

pub const <td.values_array_count>: usize = <arrsValidEnumNames.Length>;

pub const <td.values_array>: &[i64] = &[
    <arrsValidEnumNames:{it|<it>}; separator=", ">
];

pub const <td.values_array_count>: usize = <arrsValidEnumNames.Length>;

pub const <td.encoded_values_array>: &[i64] = <td.values_array>;

pub const <td.encoded_values_array_count>: usize = <arrsEnumNames.Length>;
>>

Define_subType_enumerated_private(td/*:FE_EnumeratedTypeDefinition*/, prTd/*:FE_EnumeratedTypeDefinition*/, arrsValidEnumNames, arrsEnumNames) ::= <<
pub const <td.values_array>: &[i64] = &[
    <arrsValidEnumNames:{it|<it>}; separator=", ">
];

pub const <td.values_array_count>: usize = <arrsValidEnumNames.Length>;

pub const <td.encoded_values_array>: &[i64] = <prTd.encoded_values_array>;

pub const <td.encoded_values_array_count>: usize = <prTd.encoded_values_array_count>;
>>

/***********************************       STRING    ************************************************************/

Define_new_ia5string(td/*:FE_StringTypeDefinition*/, nMin, nMax, nCMax, arrnAlphaChars, arr_Asn1Encoding) ::= <<
#[repr(C)]
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct <td.typeName> {
    pub arr: [u8; <nCMax>],
}

impl Default for <td.typeName> {
    fn default() -> Self {
        <td.typeName> { arr: [0; <nCMax>] }
    }
}

impl std::ops::Index\<usize\> for <td.typeName> {
    type Output = u8;
    fn index(&self, i: usize) -> &Self::Output {
        &self.arr[i]
    }
}

impl std::ops::IndexMut\<usize\> for <td.typeName> {
    fn index_mut(&mut self, i: usize) -> &mut Self::Output {
        &mut self.arr[i]
    }
}

impl <td.typeName> {
    pub fn len(&self) -> usize {
        // C-style string length: position of first null byte, or full length if no null
        self.arr.iter().position(|&b| b == 0).unwrap_or(self.arr.len())
    }
}
>>

Define_subType_ia5string(td/*:FE_StringTypeDefinition*/, prTd/*:FE_StringTypeDefinition*/, soParentTypePackage, arr_Asn1Encoding) ::= <<
pub type <td.typeName> = <prTd.typeName>;
>>

/***********************************       OCTET STRING    ************************************************************/

Define_new_octet_string(td/*:FE_SizeableTypeDefinition*/, nMin, nMax, bFixedSize, arrsInvariants, arr_Asn1Encoding) ::= <<
#[repr(C)]
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct <td.typeName> {
<if(!bFixedSize)>
    pub n_count: i32,
<endif>
    pub arr: [u8; <nMax>],
}

impl Default for <td.typeName> {
    fn default() -> Self {
        <td.typeName> { <if(!bFixedSize)>n_count: 0, <endif>arr: [0; <nMax>] }
    }
}

impl std::ops::Index\<usize\> for <td.typeName> {
    type Output = u8;
    fn index(&self, i: usize) -> &Self::Output {
        &self.arr[i]
    }
}

impl std::ops::IndexMut\<usize\> for <td.typeName> {
    fn index_mut(&mut self, i: usize) -> &mut Self::Output {
        &mut self.arr[i]
    }
}

impl <td.typeName> {
    pub fn len(&self) -> usize {
<if(!bFixedSize)>
        self.n_count as usize
<else>
        self.arr.iter().position(|&b| b == 0).unwrap_or(self.arr.len())
<endif>
    }
}
>>

Define_subType_octet_string(td/*:FE_SizeableTypeDefinition*/, prTd/*:FE_SizeableTypeDefinition*/, soParentTypePackage, bFixedSize, arr_Asn1Encoding) ::= <<
pub type <td.typeName> = <prTd.typeName>;
>>

