Define_new_choice(td/*:FE_ChoiceTypeDefinition*/, sChoiceIDForNone, sFirstChildNamePresent, arrsChildren, arrsPresent, arrsCombined, nIndexMax, arrsChildrenDefinitions, arrsSizeDefinition, arr_Asn1Encoding) ::= <<
/*-- <td.typeName> --------------------------------------------*/
<arrsChildrenDefinitions; separator= "\n">

#[repr(C, i32)]
#[derive(Debug, Clone, Copy)]
pub enum <td.typeName> {
    <arrsChildren:{ch|<ch>}; separator=",\n">,
}

impl Default for <td.typeName> {
    fn default() -> Self {
        <td.typeName>::<sFirstChildNamePresent>(Default::default())
    }
}
>>

