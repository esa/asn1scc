/* SEQUENCE Decode*/
<sChildren>
>>






CHOICE_child_encode(p, sAcc, sChID, sChildBody, bFirst, sChildTag, sChildName, sChildTypeDef, sChoiceTypeName) ::= <<
<sChoiceTypeName>::<sChID>(ref <sChildName>) => {
    <sChildBody>
}
>>


CHOICE_child_decode(p, sAcc, sChID, sChildBody, bFirst, sChildTag, sChildName, sChildTypeDef, sChoiceTypeName) ::= <<
<if(!bFirst)>else <endif>if next_tag_str == "<sChildTag>" {
    let mut <sChildName>: <sChildTypeDef> = <sChildTypeDef>::default();
    <sChildBody>
    *<p> = <sChoiceTypeName>::<sChID>(<sChildName>);
}
>>


CHOICE_no_tag_encode(p, sAcc, arrsChildren, sErrCode) ::= <<
match <p> {
    <arrsChildren; separator="\n">
    _ => {                        /*COVERAGE_IGNORE*/
        *p_err_code = <sErrCode>; /*COVERAGE_IGNORE*/
        ret = false;              /*COVERAGE_IGNORE*/
    }
}
>>

CHOICE_no_tag_decode(p, sAcc, arrsChildren, sErrCode) ::= <<
{
    let mut next_tag: [u8; 256] = [0; 256];
    ret = xer::la_next_element_tag(p_byte_strm, &mut next_tag);
    if ret {
        let next_tag_str = {
            let len = next_tag.iter().position(|&b| b == 0).unwrap_or(next_tag.len());
            std::str::from_utf8(&next_tag[..len]).unwrap_or("")
        };
        <arrsChildren; separator="\n">
        else {                     /*COVERAGE_IGNORE*/
            ret = false;           /*COVERAGE_IGNORE*/
            *p_err_code = <sErrCode>; /*COVERAGE_IGNORE*/
        }
    }
}
>>

CHOICE_encode(p, sAcc, sTag, nLevel, sMainBody, sErrCode) ::= <<
/* CHOICE Encode*/
ret = xer::encode_complex_element_start(p_byte_strm, <sTag>, None, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
if ret {
    <sMainBody>
    if ret {
        ret = xer::encode_complex_element_end(p_byte_strm, <sTag>, <nLevel>);
        *p_err_code = if ret { 0 } else { <sErrCode> };
    }
}
>>


CHOICE_decode(p, sAcc, sTag, nLevel, sMainBody, sErrCode) ::= <<
/* CHOICE Decode*/
ret = xer::decode_complex_element_start(p_byte_strm, <sTag>, None);
*p_err_code = if ret { 0 } else { <sErrCode> };
if ret {
    <sMainBody>
    ret = xer::decode_complex_element_end(p_byte_strm, <sTag>);
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>




call_base_type_func_encode(p, soXmlTag, sFuncName, sBaseTypeName) ::= "ret = <sFuncName>_aux(&<p>, <if(soXmlTag)><soXmlTag><else>\"\"<endif>, p_byte_strm, p_err_code, false);"
call_base_type_func_decode(p, soXmlTag, sFuncName, sBaseTypeName) ::= "ret = <sFuncName>_aux(&mut <p>, <if(soXmlTag)><soXmlTag><else>\"\"<endif>, p_byte_strm, p_err_code);"
