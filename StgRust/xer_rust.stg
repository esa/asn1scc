String_encode(p, sTag, nLevel, soCheckExp, sErrCode) ::= <<
ret = xer::encode_string(p_byte_strm, <sTag>, <p>, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
>>

String_decode(p, sTag, nLevel, soCheckExp, sErrCode) ::= <<
{
    let mut tmp: [u8; 1024] = [0; 1024];
    ret = xer::decode_string(p_byte_strm, <sTag>, &mut tmp, 1024);
    if ret {
        let mut i: usize = 0;
        while i \< tmp.len() && tmp[i] != 0 {
            <p>[i] = tmp[i];
            i += 1;
        }
    }
    <if(soCheckExp)><soCheckExp><endif>
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>



Enumerated_item_encode(p, sTag, nLevel, sItemID, sXerValue, sErrCode, bFirst) ::= <<
<sItemID> => {
    ret = xer::encode_enumerated(p_byte_strm, <sTag>, "<sXerValue>", <nLevel>);
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>

Enumerated_encode(p, sTag, nLevel, arrsItems, soCheckExp, sErrCode) ::= <<
match <p> {
    <arrsItems; separator="\n">
    _ => {                        /*COVERAGE_IGNORE*/
        *p_err_code = <sErrCode>; /*COVERAGE_IGNORE*/
        ret = false;              /*COVERAGE_IGNORE*/
    }
}
>>



Enumerated_item_decode(p, sTag, nLevel, sItemID, sXerValue, sErrCode, bFirst) ::= <<
<if(!bFirst)>else <endif>if enm_label == "<sXerValue>" {
    <p> = <sItemID>;
}
>>

Enumerated_decode(p, sTag, nLevel, arrsItems, soCheckExp, sErrCode) ::= <<
{
    let mut enm_label: [u8; 200] = [0; 200];
    ret = xer::decode_enumerated(p_byte_strm, <sTag>, &mut enm_label);
    if ret {
        let enm_label_str = {
            let len = enm_label.iter().position(|&b| b == 0).unwrap_or(enm_label.len());
            std::str::from_utf8(&enm_label[..len]).unwrap_or("")
        };
        <arrsItems; separator="\n">
        else {                     /*COVERAGE_IGNORE*/
            *p_err_code = <sErrCode>; /*COVERAGE_IGNORE*/
        }
    } else {
        *p_err_code = <sErrCode>; /*COVERAGE_IGNORE*/
    }
    <if(soCheckExp)><soCheckExp><endif>
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>



OctetString_encode(p, sAcc, sTag, nLevel, nSizeMax, bIsFixedSize, soCheckExp, sErrCode) ::= <<
ret = xer::encode_octet_string(p_byte_strm, <sTag>, &<p><sAcc>arr, <if(!bIsFixedSize)><p><sAcc>n_count<else><nSizeMax><endif> as i32, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
>>

OctetString_decode(p, sAcc, sTag, nLevel, nSizeMax, bIsFixedSize, soCheckExp, sErrCode) ::= <<
ret = xer::decode_octet_string(p_byte_strm, <sTag>, &mut <p><sAcc>arr, <nSizeMax> as i32, <if(!bIsFixedSize)>&mut <p><sAcc>n_count<else>&mut { let mut dummy = 0i32; &mut dummy }<endif>);
<if(soCheckExp)><soCheckExp><endif>
*p_err_code = if ret { 0 } else { <sErrCode> };
>>


BitString_encode(p, sAcc, sTag, nLevel, nSizeMax, bIsFixedSize, soCheckExp, sErrCode) ::= <<
ret = xer::encode_bit_string(p_byte_strm, <sTag>, &<p><sAcc>arr, <if(!bIsFixedSize)><p><sAcc>n_count<else><nSizeMax><endif> as i32, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
>>

BitString_decode(p, sAcc, sTag, nLevel, nSizeMax, bIsFixedSize, soCheckExp, sErrCode) ::= <<
ret = xer::decode_bit_string(p_byte_strm, <sTag>, &mut <p><sAcc>arr, <nSizeMax> as i32, <if(!bIsFixedSize)>&mut <p><sAcc>n_count<else>&mut { let mut dummy = 0i32; &mut dummy }<endif>);
<if(soCheckExp)><soCheckExp><endif>
*p_err_code = if ret { 0 } else { <sErrCode> };
>>



SequenceOf_encode(p, sAcc, sTag, nLevel, sI, nSizeMax, sChildBody, bFixedSize, soCheckExp, sErrCode, sElemTypeDef) ::= <<
/* SEQUENCE OF Encode*/
ret = xer::encode_complex_element_start(p_byte_strm, <sTag>, None, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
if ret {
    <sI> = 0;
    while <sI> \< <if(!bFixedSize)><p><sAcc>n_count<else><nSizeMax><endif> as usize && ret {
        <sChildBody>
        <sI> += 1;
    }
    if ret {
        ret = xer::encode_complex_element_end(p_byte_strm, <sTag>, <nLevel>);
        *p_err_code = if ret { 0 } else { <sErrCode> };
    }
}
>>


SequenceOf_decode(p, sAcc, sTag, nLevel, sI, nSizeMax, sChildBody, bFixedSize, soCheckExp, sErrCode, sElemTypeDef) ::= <<
/* SEQUENCE OF Decode*/
ret = xer::decode_complex_element_start(p_byte_strm, <sTag>, None);
if ret {
    <if(!bFixedSize)><p><sAcc>n_count = 0;<endif>
    <sI> = 0;
    while ret && !xer::next_end_element_is(p_byte_strm, <sTag>) {
        if <sI> \>= <nSizeMax> as usize {
            ret = false;
            *p_err_code = <sErrCode>;
            break;
        }
        <sChildBody>
        <sI> += 1;
        <if(!bFixedSize)><p><sAcc>n_count += 1;<endif>
    }
    if ret {
        ret = xer::decode_complex_element_end(p_byte_strm, <sTag>);
    }
}
<if(bFixedSize)>
*p_err_code = if ret && <sI> == <nSizeMax> as usize { 0 } else { <sErrCode> };

<else>
<if(soCheckExp)><soCheckExp><endif>
*p_err_code = if ret { 0 } else { <sErrCode> };

<endif>
>>



/* SEQUENCE Start*/

Sequence_mandatory_child_encode(sChName, sChildContent, sChildTag, sChildTypeDef) ::= <<
/*Encode <sChName> */
<sChildContent>
>>

Sequence_mandatory_child_decode(sChName, sChildContent, sChildTag, sChildTypeDef) ::= <<
/*Decode <sChName> */
ret = xer::next_start_element_is(p_byte_strm, "<sChildTag>");
if ret {
    <sChildContent>
}
>>

Sequence_optional_child_encode(p, sAcc, sChName, sChildContent, sChildTag, sChildTypeDef) ::= <<
/*Encode <sChName> */
if <p><sAcc>exist.<sChName> {
    <sChildContent>
}
>>

Sequence_optional_child_decode(p, sAcc, sChName, sChildContent, sChildTag, sChildTypeDef) ::= <<
/*Decode <sChName> */
if xer::next_start_element_is(p_byte_strm, "<sChildTag>") {
    <p><sAcc><sChName> = Some(Default::default());
    <sChildContent>
} else {
    <p><sAcc><sChName> = None;
}
>>

Sequence_default_child_encode(p, sAcc, sChName, sChildContent, sChildTag, sInitWithDefaultValue, sChildTypeDef) ::= <<
<Sequence_optional_child_encode(p=p, sAcc=sAcc, sChName=sChName, sChildContent=sChildContent, sChildTag=sChildTag)>
>>


Sequence_default_child_decode(p, sAcc, sChName, sChildContent, sChildTag, sInitWithDefaultValue, sChildTypeDef) ::= <<
/*Decode <sChName> */
if xer::next_start_element_is(p_byte_strm, "<sChildTag>") {
    <p><sAcc><sChName> = Some(Default::default());
    <sChildContent>
} else {
    <sInitWithDefaultValue>
}
>>


