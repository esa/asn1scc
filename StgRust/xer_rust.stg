{
    if let Some(val) = xer::decode_pos_integer(p_byte_strm, <sTag>) {
        <p> = val as i64;
        ret = true;
    } else {
        ret = false;
    }
    <if(soCheckExp)><soCheckExp><endif>
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>

