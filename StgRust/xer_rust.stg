group rust_xer;

rtlModuleName() ::= ""


EmitTypeAssignment_def_err_code(sErrCode, nErrValue, sFieldPath) ::= <<
pub const <sErrCode>: i32 = <nErrValue>;
>>


EmitTypeAssignment_def_encode(sVarName, sStar, sFuncName, sTypeDefName, arrsErrcodes, bEmptyEncodingSpace, nMaxBytesInXER, soSparkAnnotations) ::= <<
<arrsErrcodes; separator="\n">
pub const <sTypeDefName>_REQUIRED_BYTES_FOR_XER_ENCODING: usize = <nMaxBytesInXER>;
>>

EmitTypeAssignment_encode(sTasName, sVarName, sStar, sFuncName, soIValidFuncName, sTypeDefName, arrsLocalVariables, sContent, soSparkAnnotations, sInitialExp) ::= <<
pub fn <sFuncName>_aux(<sVarName>: &<sTypeDefName><sStar>, xml_tag: &str, p_byte_strm: &mut ByteStream, p_err_code: &mut i32, b_check_constraints: bool) -> bool {
    let mut ret: bool = true;
    let _ = <sVarName>;
    let _ = xml_tag;
    let _ = p_byte_strm;

    <arrsLocalVariables:{lv|<lv>}; separator="\n">
    <if(soIValidFuncName)>
    *p_err_code = 0;
    ret = if b_check_constraints { <soIValidFuncName>(<sVarName>, p_err_code) } else { true };
    if ret {
        <sContent>
    }

    <else>
    *p_err_code = 0;
    let _ = b_check_constraints;
    <sContent>

    <endif>

    ret
}

pub fn <sFuncName>(<sVarName>: &<sTypeDefName><sStar>, p_byte_strm: &mut ByteStream, p_err_code: &mut i32, b_check_constraints: bool) -> bool {
    <sFuncName>_aux(<sVarName>, "<sTasName>", p_byte_strm, p_err_code, b_check_constraints)
}
>>

EmitTypeAssignment_def_decode(sVarName, sStar, sFuncName, sTypeDefName, arrsErrcodes, bEmptyEncodingSpace, nMaxBytesInXER, soSparkAnnotations) ::= <<
<arrsErrcodes; separator="\n">
>>

EmitTypeAssignment_decode(sTasName, sVarName, sStar, sFuncName, soIValidFuncName, sTypeDefName, arrsLocalVariables, sContent, soSparkAnnotations, sInitialExp) ::= <<
pub fn <sFuncName>_aux(<sVarName>: &mut <sTypeDefName><sStar>, xml_tag: &str, p_byte_strm: &mut ByteStream, p_err_code: &mut i32) -> bool {
    let mut ret: bool = true;
    <arrsLocalVariables:{lv|<lv>}; separator="\n">
    let _ = <sVarName>;
    let _ = xml_tag;
    let _ = p_byte_strm;
    let _ = p_err_code;

    <sContent>

    ret
}

pub fn <sFuncName>(<sVarName>: &mut <sTypeDefName><sStar>, p_byte_strm: &mut ByteStream, p_err_code: &mut i32) -> bool {
    <sFuncName>_aux(<sVarName>, "<sTasName>", p_byte_strm, p_err_code)
}
>>




Integer_encode(p, sTag, nLevel, soCheckExp, sErrCode) ::= <<
ret = xer::encode_integer(p_byte_strm, <sTag>, <p>, <nLevel>);
*p_err_code = if ret { 0 } else { <sErrCode> };
>>

Integer_decode(p, sTag, nLevel, soCheckExp, sErrCode) ::= <<
{
    if let Some(val) = xer::decode_integer(p_byte_strm, <sTag>) {
        <p> = val;
        ret = true;
    } else {
        ret = false;
    }
    <if(soCheckExp)><soCheckExp><endif>
    *p_err_code = if ret { 0 } else { <sErrCode> };
}
>>

