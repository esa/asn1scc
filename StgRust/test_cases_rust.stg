group rust_test_cases;

rtlModuleName() ::= ""


PrintAutomaticTestCasesSpecFile(sModNameUpperCase, sModName, arrsIncludedModules, arrsTestFunctions) ::= <<
// Code automatically generated by asn1scc
// Do not edit manually.

use asn1rust::*;

<arrsIncludedModules:{inc|use crate::<inc>Def::*;}; separator="\n">

>>


PrintAutomaticTestCasesBodyFile(sModName, sTetscaseSpecFileName, arrsIncludedModules, arrsTasNames, arrsTypeAssignments, bXer) ::= <<
// Code automatically generated by asn1scc

use asn1rust::*;
use crate::<sTetscaseSpecFileName>::*;
use crate::<sModName>Def::*;
use crate::<sModName>::*;

<arrsIncludedModules: {inc|use crate::<inc>Def::*;}; separator="\n">

<arrsTypeAssignments:{tas|<tas>}; separator="\n">
>>




/* Encode Decode start */




Codec_Encode(sModName, sFuncName, sVal) ::= <<
// Encode value
ret = <sFuncName>(&<sVal>, &mut bit_strm, &mut err_code, true);
if ret && err_code == 0 { err_code = 0; } else { err_code = 1; }
>>

Codec_Decode(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
bit_strm.current_byte = 0;
bit_strm.current_bit = 0;
// Decode value
ret = <sFuncName>(&mut decoded_pdu, &mut bit_strm, &mut err_code);
if ret && err_code == 0 { err_code = 0; } else { err_code = 2; }
>>

/* 'size deduced' PDU: the decoder derives element counts from the end of the
   bitstream view, so it must be attached to exactly the encoded PDU length */
Codec_Decode_exact_length(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
{
    let enc_len = bit_strm.get_length() as usize;
    bit_strm.current_byte = 0;
    bit_strm.current_bit = 0;
    bit_strm.count = enc_len as i64;
}
// Decode value
ret = <sFuncName>(&mut decoded_pdu, &mut bit_strm, &mut err_code);
if ret && err_code == 0 { err_code = 0; } else { err_code = 2; }
>>

Codec_Decode_XER(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
// Decode value
ret = <sFuncName>(&mut decoded_pdu, &mut byte_strm, &mut err_code);
if ret && err_code == 0 { err_code = 0; } else { err_code = 2; }
>>

Codec_validate_output(sModName, sFuncName, sAmber) ::= <<
// validate decoded data
ret = <sFuncName>(&decoded_pdu, &mut err_code);
if ret && err_code == 0 { err_code = 0; } else { err_code = 3; }
>>

Codec_compare_input_with_output(sModName, sFuncName, sVal, sAmber) ::= <<
ret = <sFuncName>(&<sVal>, &decoded_pdu);
if ret { err_code = 0; } else { err_code = 4; }
>>

Codec_write_CharstreamToFile() ::= <<
std::fs::write(format!("{}.xml", filename), &byte_strm.buf[..byte_strm.current_byte as usize]).unwrap();
>>

Codec_write_bitstreamToFile() ::= <<
let n_bytes = if bit_strm.current_bit \> 0 { bit_strm.current_byte + 1 } else { bit_strm.current_byte };
std::fs::write(format!("{}.dat", filename), &bit_strm.buf[..n_bytes as usize]).unwrap();
>>

JoinItems(sPart, soNestedPart) ::= <<
<sPart>
<if(soNestedPart)>
if ret {
    <soNestedPart>
}

<endif>
>>


Codec_declare_EncInDecOut_variable(sPrmName, sType, sPrmValue) ::= <<
let enc_<sPrmName>: <sType> = <sPrmValue>;
let mut dec_<sPrmName>: <sType> = Default::default();
>>

Codec_declare_DecIn_variable(sPrmName, sType) ::= "let mut dec_<sPrmName>: <sType> = Default::default();"


PrintCodec_spec(sFuncName, sModName, sTasName, sStar, sVal) ::= <<
pub fn <sFuncName>(<sVal>: &<sTasName>, err_code_out: &mut i32, filename: &str) -> bool;
>>

PrintCodec_body(sModName, sFuncName, sTasName, sStar,  sVal, sEnc, sNestedStatements, sCodecClass) ::= <<
pub fn <sFuncName>(<sVal>: &<sTasName>, err_code_out: &mut i32, filename: &str) -> bool {
    let mut decoded_pdu: <sTasName> = Default::default();
    let mut enc_buff: [u8; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1] = [0; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1]; /* +1 for zerosized types */
    let mut bit_strm = BitStream::new(&mut enc_buff);
    let mut ret: bool = true;
    let mut err_code: i32 = 0;

    <sNestedStatements>
    *err_code_out = err_code;
    return ret;
}
>>

PrintCodec_body_XER(sModName, sFuncName, sTasName, sStar,  sVal, sEnc, sNestedStatements) ::= <<
pub fn <sFuncName>(<sVal>: &<sTasName>, err_code_out: &mut i32, filename: &str) -> bool {
    let mut decoded_pdu: <sTasName> = Default::default();
    let mut enc_buff: [u8; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1] = [0; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1]; /* +1 for zerosized types */
    let mut byte_strm = ByteStream::init(&mut enc_buff);
    let mut ret: bool = true;
    let mut err_code: i32 = 0;

    <sNestedStatements>
    *err_code_out = err_code;
    return ret;
}
>>




/* Encode Decode End */


PrintMain(sTestSuiteFilename, arrsProgramUnitNames) ::= <<
// Code automatically generated by asn1scc
// Test runner main entry point

mod <sTestSuiteFilename>;
mod <sTestSuiteFilename>Def;
<arrsProgramUnitNames:{pu|mod <pu>;
mod <pu>Def;}; separator="\n">

use <sTestSuiteFilename>::*;

fn main() {
    let exit_code = asn1scc_run_generated_testsuite();
    std::process::exit(exit_code);
}
>>





PrintSuite_call_codec_generate_dat_file(sModName, sTasName, sAmber, sEnc, sStreamName) ::= <<
if result {
    let mut enc_buff: [u8; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1] = [0; <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1];
    let mut bit_strm = <sStreamName>Stream::new(&mut enc_buff);
    let mut err_code: i32 = 0;

    result = <sTasName>_<sEnc>Encode(&tmp, &mut bit_strm, &mut err_code, true);
    let n_bytes = bit_strm.get_length() as usize;
    std::fs::write("asn1scc_<sEnc>.dat", &bit_strm.buf[..n_bytes]).unwrap();
}
>>




PrintATCRunnerDefinition() ::= <<
// Test suite runner definition
// Rust uses the standard test framework; this file provides the test runner
>>


PrintATCRunner(sTestSuiteFilename, arrsIncludedModules, arrsVars, arrsTestFunctions, arrsUsedPackages, arrsInitCalls, bGenerateDatFile) ::= <<
// Code automatically generated by asn1scc (stg macro : PrintATCRunner)

use asn1rust::*;
<arrsIncludedModules:{inc| use crate::<inc>::*;}; separator="\n">

pub fn asn1scc_run_generated_testsuite() -> i32 {
    let mut total_errors: i32 = 0;
    <arrsVars; separator="\n">

    <arrsTestFunctions;separator="\n\n">

    // used to increase statement coverage
    <arrsInitCalls; separator="\n\n">

    if total_errors \> 0 {
        println!("{} out of <arrsTestFunctions.Length> failed.", total_errors);
        1
    } else {
        println!("All test cases (<arrsTestFunctions.Length>) run successfully.");
        0
    }
}
>>



invokeTestCaseAsFunc(sFuncName) ::= <<
<sFuncName>(&mut total_errors);
>>


emitTestCaseAsFunc_h(sFuncName) ::= <<
pub fn <sFuncName>(total_errors: &mut i32);
>>

emitTestCaseAsFunc_dummy_init(sTypeName, sFuncName, sDummyVarname) ::= "<sFuncName>(&mut <sDummyVarname>);"

emitTestCaseAsFunc_dummy_init_function(sTypeName, sFuncName, sDummyVarname) ::= <<
let dummy: <sTypeName> = <sFuncName>();
let _ = dummy;
>>

emitTestCaseAsFunc(sFuncName, arrsVars, sModName, sTasName, sAmber, sEnc, bValueAssignment, sInitializeTcData, bStatic, sGenerateDatFile, arrsDummyInitStatementsNeededForStatementCoverage, sInitAmber) ::= <<
pub fn <sFuncName>(total_errors: &mut i32) {
    let mut result: bool = false;
    let mut err_code: i32 = 0;
    <arrsVars; separator="\n">

    <if(arrsDummyInitStatementsNeededForStatementCoverage)>
    {
        // dummy statement used for calling init functions
        let mut tmp0: <sTasName> = Default::default();
        <arrsDummyInitStatementsNeededForStatementCoverage; separator="\n">
    }

    <endif>
    <if(bValueAssignment)><if(bStatic)>let <else>let mut <endif><else>let mut <endif>tc_data: <sTasName><if(bValueAssignment)> = <else> = Default::default();<endif>
    <sInitializeTcData><if(bValueAssignment)>;<endif>

    result = <sTasName>_<sEnc>enc_dec(<sAmber>tc_data, &mut err_code, "<sFuncName>");

    if !result {
        match err_code {
            1 => println!("Test case <sFuncName> failed in encoding."),
            2 => println!("Test case '<sFuncName>' failed in decoding."),
            3 => println!("Test case '<sFuncName>' failed in the validation of the decoded message."),
            4 => println!("Test case '<sFuncName>' failed. Encoded and decoded messages are different."),
            _ => println!("Unexpected error code in test case '<sFuncName>'."),
        }
        println!("========================================");
        *total_errors += 1;
    }
    <sGenerateDatFile>
}
>>


