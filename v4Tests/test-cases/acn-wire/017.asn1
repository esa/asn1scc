-- Issue 171: the ACN decoder of an IA5String / NumericString with the default encoding (the uPER body) that a WITH
-- COMPONENT(S) constraint narrows reads the length field of the PER-visible range (inner subtype constraints are not
-- PER-visible), while REQUIRED_BITS counts only the narrowed characters (Issue 168). It now rejects a length above the
-- narrowed maximum right after the length field (type's error code; also the fragmentation decoder of a base >= 64K,
-- OuterG / OuterG2), before the characters; a length below the narrowed minimum is left to the validation (OuterM5:
-- SIZE(MIN..2) is 1..2 since Issue 173, before 2..6 with no check). Before, C read the characters and failed later,
-- Ada read past REQUIRED_BITS (with -gnata a precondition / the decoder's postcondition failed; PDU: FALSE with error
-- code 0; OuterF / OuterE were classified "cannot fail"). No wire change: valid rows are encoded back byte-exact.
-- Issue 172: the Ada value-set check of a BIT / OCTET STRING whose typedef allows length 0 (OuterB4 / OuterO4, uPER)
-- called BitString_equal / OctetString_equal with a decoded length 0 (RTL precondition len1 > 0, relaxed).
-- No directives: run by v4Tests/scripts/runWireTests.sh with 017_wire_test.c (-DNDEBUG, ASan / UBSan) /
-- 017_wire_test.adb (with and without -gnata), streams of exactly REQUIRED_BYTES, legacy and --acn-v2.
ACN-WIRE-SITE-DECODE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
    InS     ::= SEQUENCE { s IA5String (SIZE(1..6)), b BOOLEAN }
    OuterS  ::= SEQUENCE { x InS (WITH COMPONENTS { ..., s ("ab" | "a") }) }
    InN     ::= SEQUENCE { n NumericString (SIZE(1..12)), b BOOLEAN }
    OuterN  ::= SEQUENCE { x InN (WITH COMPONENTS { ..., n ("12" | "345") }) }
    PDU     ::= SEQUENCE { a OuterN, f SEQUENCE (SIZE(4)) OF BOOLEAN }
    InF     ::= SEQUENCE { s IA5String (SIZE(0..7)), b BOOLEAN }
    OuterF  ::= SEQUENCE { x InF (WITH COMPONENTS { ..., s (SIZE(1..2)) }) }
    InE     ::= SEQUENCE { s IA5String (SIZE(0..3)) (FROM("abcd")), b BOOLEAN }
    OuterE  ::= SEQUENCE { x InE (WITH COMPONENTS { ..., s (SIZE(0..1)) }) }
    InM     ::= SEQUENCE { s IA5String (SIZE(1..20)), b BOOLEAN }
    OuterM  ::= SEQUENCE { x InM (WITH COMPONENTS { ..., s (SIZE(3..4)) }) }
    OuterM2 ::= SEQUENCE { x InS (WITH COMPONENTS { ..., s (SIZE(1) | SIZE(5)) }) }
    OuterM5 ::= SEQUENCE { x InS (WITH COMPONENTS { ..., s (SIZE(MIN..2)) }) }
    InG     ::= SEQUENCE { s IA5String (SIZE(1..70000)), b BOOLEAN }
    OuterG  ::= SEQUENCE { x InG (WITH COMPONENTS { ..., s (SIZE(2)) }) }
    OuterG2 ::= SEQUENCE { x InG (WITH COMPONENTS { ..., s (SIZE(200)) }) }
    OuterH  ::= CHOICE { a InS (WITH COMPONENTS { ..., s ("ab" | "a") }), z BOOLEAN }
    OuterJ  ::= SEQUENCE (SIZE(2)) OF InS (WITH COMPONENTS { ..., s (SIZE(1..2)) })
    SoK     ::= SEQUENCE (SIZE(1..3)) OF IA5String (SIZE(1..6))
    OuterK  ::= SEQUENCE { k SoK (WITH COMPONENT (SIZE(1..2))), b BOOLEAN }
    Wrap    ::= SEQUENCE { p InS (WITH COMPONENTS { ..., s (SIZE(1..2)) }), d OCTET STRING (SIZE(0..4)) }
    OuterQ  ::= SEQUENCE { w1 Wrap, w2 Wrap }
    InB4    ::= SEQUENCE { b BIT STRING (SIZE(0..60)), k BOOLEAN }
    OuterB4 ::= SEQUENCE { x InB4 (WITH COMPONENTS { ..., b ('1010'B | '11'B) }) }
    InO4    ::= SEQUENCE { o OCTET STRING (SIZE(0..10)), k BOOLEAN }
    OuterO4 ::= SEQUENCE { x InO4 (WITH COMPONENTS { ..., o ('0102'H | '03'H) }) }
END
