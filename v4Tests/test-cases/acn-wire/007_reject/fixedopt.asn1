-- a constant consumer (SIZE(3)) behind an OPTIONAL component inside the elements, same function: whether it is encoded
-- is a flag of the element (legacy and --acn-v2 reject; Codex i124a F3)
REJ DEFINITIONS AUTOMATIC TAGS ::= BEGIN
    T ::= SEQUENCE { b BOOLEAN, items SEQUENCE (SIZE(1..2)) OF SEQUENCE { o OCTET STRING (SIZE(3)) OPTIONAL } }
END
