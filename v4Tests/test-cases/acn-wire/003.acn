WIRE DEFINITIONS ::= BEGIN
    MyPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], n INTEGER [size 8, encoding pos-int], m INTEGER [size 8, encoding pos-int] },
        data [present-when flg2, size header.n],
        str  [present-when flg2, size header.m]
    }
    ChPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], k Kind [encoding pos-int, size 1] },
        ch [determinant header.k, present-when flg2]
    }
    PwPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], t INTEGER [size 2, encoding pos-int] },
        cp [present-when flg2] { p1 [present-when header.t==1], p2 [present-when header.t==2] }
    }
    PwStrPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], s Tag [] },
        cs [present-when flg2] { s1 [present-when header.s=="ab"], s2 [present-when header.s=="cd"] }
    }
    BoolPDU [] {
        flg BOOLEAN [],
        header [present-when flg] { a [], more BOOLEAN [] },
        x [present-when header.more],
        tail []
    }
    ElemPDU [] {
        elems [] {
          [] {
            e1 BOOLEAN [],
            e2 BOOLEAN [],
            hh [present-when e1] { a [], n INTEGER [size 4, encoding pos-int] },
            dd [present-when e2, size hh.n]
          }
        }
    }
    NestPDU [] {
        f1 BOOLEAN [],
        f3 BOOLEAN [],
        h1 [present-when f1] { f2 BOOLEAN [], a [], h2 [present-when f2] { b [], n INTEGER [size 4, encoding pos-int] } },
        d [present-when f3, size h1.h2.n]
    }
    AltPDU [] {
        flg BOOLEAN [],
        header [present-when flg] { a [], n INTEGER [size 4, encoding pos-int] },
        alt [] { o1 [size header.n], o2 [] }
    }
    ContPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], cl INTEGER [size 4, encoding pos-int] },
        cont [present-when flg2, size header.cl]
    }
    Payload <INTEGER:len> [] { d [size len] }
    ArgPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], n INTEGER [size 4, encoding pos-int] },
        pl <header.n> [present-when flg2],
        tail []
    }
    Payload2 <INTEGER:len> [] { has BOOLEAN [], d [present-when has, size len], e [] }
    OptArgPDU [] {
        flg BOOLEAN [],
        flg2 BOOLEAN [],
        header [present-when flg] { a [], n INTEGER [size 4, encoding pos-int] },
        pl <header.n> [present-when flg2],
        tail []
    }
    AbsPDU [] {
        flg2 BOOLEAN [],
        header [] { a [], n INTEGER [size 4, encoding pos-int] },
        data [present-when flg2, size header.n]
    }
    SamePDU [] {
        flg BOOLEAN [],
        header [present-when flg] { a [], n INTEGER [size 4, encoding pos-int] },
        data [present-when flg, size header.n]
    }
END
