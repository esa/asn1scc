-- C_ADA_ONLY (Python: the ACN IEEE754-1985-32 encoders fail with "Cannot write beyond end of bitstream", pre-existing)
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

	MyR ::= REAL (-10.0 .. 10.0)
	MyR32 ::= REAL
	MyQ ::= MyR32 (-5.0 .. 5.0)

	MyPDU ::= SEQUENCE {
		a REAL (0.0 .. 1.0),
		b SEQUENCE (SIZE(1 .. 3)) OF REAL,
		c CHOICE { r REAL, i INTEGER (0 .. 5) },
		d MyR,
		e MyQ,
		f MyR32,
		g SEQUENCE { r REAL OPTIONAL }
	}

END

-- REAL values encoded as IEEE754-1985-32 that are not type assignments of their own (components, SEQUENCE OF
-- elements, CHOICE alternatives, reference sites). With -slim the decoders read a 32-bit float: a component gets a
-- 32-bit typedef of its own (as a type assignment does), and a reference site keeps the referenced type's typedef, so
-- its codecs follow that type (MyR: 64-bit, decoded with the IEEE754-1985-32 decoder into a 64-bit value; MyQ / MyR32:
-- 32-bit). Before, the decoders of -slim took the 32-bit variant while the value was 64-bit, and did not compile.
--TCLS     MyR32[encoding IEEE754-1985-32] MyPDU[] { a [encoding IEEE754-1985-32], b [] { [encoding IEEE754-1985-32] }, c [] { r [encoding IEEE754-1985-32], i [] }, d [encoding IEEE754-1985-32], e [], f [], g [] { r [encoding IEEE754-1985-32, endianness little] } }
--TCLS     MyR32[encoding IEEE754-1985-32, endianness little] MyPDU[] { a [encoding IEEE754-1985-32, endianness little], b [], c [], d [encoding IEEE754-1985-32, endianness little], e [encoding IEEE754-1985-32], f [], g [] }
--TCLS     MyPDU[] { a [encoding IEEE754-1985-64], b [] { [encoding IEEE754-1985-32] }, c [], d [], e [encoding IEEE754-1985-32], f [encoding IEEE754-1985-32], g [] }
