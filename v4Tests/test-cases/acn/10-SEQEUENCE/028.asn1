-- An ALWAYS PRESENT child (WITH COMPONENTS PRESENT) of a type that the tested value reaches through two
-- reference sites (Top.s and Top.w.s): its "x absent" constraint-violation test must not replace the test that
-- the reference site Top.w had before (w.b = 0, outside 1..2), it may only be added.
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

   Shared ::= SEQUENCE { x BOOLEAN OPTIONAL } (WITH COMPONENTS { ..., x PRESENT })

   Wrap ::= SEQUENCE { s Shared, b INTEGER (1..2) OPTIONAL }

   Top ::= SEQUENCE { w Wrap, s Shared }

END

--TCLS     Shared[] Wrap[] Top[]
