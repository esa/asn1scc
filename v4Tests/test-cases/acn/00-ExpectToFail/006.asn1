TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

	-- Issue 53 (see 005): a size or presence determinant inside an OPTIONAL
	-- component used by a component outside it.
	Holder2 ::= SEQUENCE {
		header SEQUENCE { b INTEGER (0..7) } OPTIONAL,
		list SEQUENCE (SIZE (0..3)) OF INTEGER (0..7)
	}

	Holder3 ::= SEQUENCE {
		header SEQUENCE { b INTEGER (0..7) } OPTIONAL,
		opt INTEGER (0..7) OPTIONAL
	}

END

--TCLFC    Holder2 [] { header [] { len INTEGER [encoding pos-int, size 2], b [] }, list [size header.len] }          $$$ sample1.acn:4:85: error: Invalid reference 'header.len': component 'header' is OPTIONAL, so the ACN fields inside it are not encoded when it is absent. Only components inside 'header' may refer to them.
--TCLFC    Holder3 [] { header [] { flag BOOLEAN [], b [] }, opt [present-when header.flag] }          $$$ sample1.acn:4:69: error: Invalid reference 'header.flag': component 'header' is OPTIONAL, so the ACN fields inside it are not encoded when it is absent. Only components inside 'header' may refer to them.
