--RUN_SPARK
-- CHOICEs whose index fills its field (2^k alternatives, k = 1 and k = 0) and whose alternatives may fail, each one
-- writing the result on every path: the Ada decoders read the index with the full-range read and run the case on it
-- without a range guard. Here only CHOICEs decoded in place inside a SEQUENCE (an alternative may be a call: PDU.inl.q);
-- CHOICE type assignments of the same shape are in 024 (not proved: the assignment of a whole variant record to the
-- in out parameter of their decoder gives "discriminant check might fail").
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

Inner ::= SEQUENCE {
    x INTEGER (0..5),
    y BOOLEAN
}

PDU ::= SEQUENCE {
    h   BOOLEAN,
    inl CHOICE { p INTEGER (1..3), q Inner },
    two CHOICE { a INTEGER (0..10), b SEQUENCE { x INTEGER (0..5), y BOOLEAN } },
    one CHOICE { r INTEGER (0..100) }
}

pdu1 PDU ::= { h TRUE, inl q : { x 5, y FALSE }, two b : { x 3, y TRUE }, one r : 100 }

END

--TCLS PDU[] { h [], inl [] { p [], q [] }, two [] { a [], b [] }, one [] { r [] } }
--TCLS PDU[] { h [], inl [] { p [encoding pos-int, size 8], q [] }, two [] { a [encoding pos-int, size 8], b [] }, one [] { r [encoding pos-int, size 8] } }
