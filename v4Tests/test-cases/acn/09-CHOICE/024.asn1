-- CHOICE type assignments whose index fills its field (2^k alternatives, k = 1 and k = 0) and whose alternatives may
-- fail, each one writing the result on every path: the Ada decoders read the index with the full-range read and run
-- the case on it without a range guard; decoded by their own functions (Two, One) and by calls (PDU.ref, PDU.single).
-- The in-place shape is proved in 023.
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

Two ::= CHOICE {
    a INTEGER (0..10),
    b SEQUENCE { x INTEGER (0..5), y BOOLEAN }
}

One ::= CHOICE {
    only INTEGER (1..6)
}

PDU ::= SEQUENCE {
    h      BOOLEAN,
    ref    Two,
    single One
}

pdu1 PDU ::= { h TRUE, ref b : { x 5, y FALSE }, single only : 6 }

END

--TCLS PDU[] { h [], ref [], single [] }
--TCLS Two[]
