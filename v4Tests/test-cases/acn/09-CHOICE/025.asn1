--RUN_SPARK NOCOVERAGE C_ADA_ONLY (NOCOVERAGE: the arm of the ALWAYS ABSENT alternative PDU5.t.gone is not reached by valid values; Python: an inline CHOICE with WITH COMPONENTS at the site fails)
-- Alternatives and components that have an alignment and no content of their own (a NULL without pattern, aligned to
-- the next byte) are decoded as the alignment only and write no result: the Ada decoders must not count on them for
-- result.Success / ErrorCode. PDU1: such an alternative beside one that may fail; PDU3: an inline SEQUENCE holding only
-- such a component as an alternative; PDU4: such an alternative beside a plain NULL (full index); PDU5: the same SEQUENCE
-- as the live alternative of a CHOICE selected by an ENUMERATED field, the other alternative ALWAYS ABSENT; S2: such a
-- component before an INTEGER. Each CHOICE is the first component of its SEQUENCE and a mandatory component follows.
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

S2 ::= SEQUENCE { z NULL, n INTEGER (0..5) }
PDU1 ::= SEQUENCE { item CHOICE { pad NULL, n INTEGER (0..5) }, tail BOOLEAN }
PDU3 ::= SEQUENCE { item CHOICE { e SEQUENCE { z NULL }, n INTEGER (0..5) }, tail BOOLEAN }
PDU4 ::= SEQUENCE { item CHOICE { pad NULL, q NULL }, tail BOOLEAN }
Sel ::= ENUMERATED { live, gone }
PDU5 ::= SEQUENCE { t CHOICE { live SEQUENCE { pad NULL }, gone BOOLEAN } (WITH COMPONENTS {gone ABSENT}), tail BOOLEAN }

END

--TCLS S2 [] { z [align-to-next byte], n [] } PDU1 [] { item [] { pad [align-to-next byte], n [] }, tail [] } PDU3 [] { item [] { e [] { z [align-to-next byte] }, n [] }, tail [] } PDU4 [] { item [] { pad [align-to-next byte], q [] }, tail [] } PDU5 [] { sel Sel [encoding pos-int, size 1], t [determinant sel] { live [] { pad [align-to-next byte] }, gone [] }, tail [] }
