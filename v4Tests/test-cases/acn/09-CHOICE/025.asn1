--RUN_SPARK
-- Full-index CHOICEs decoded in place, each the first component of its SEQUENCE with a mandatory component after it.
-- The Ada decoder runs the case on the index without a range check only when every alternative is a checked INTEGER
-- read or a call of a type assignment's decoder (PDU6), or when no alternative can fail or writes the result (PDU4,
-- every alternative an aligned NULL). Alternatives that write no result (an aligned NULL, an inline SEQUENCE OF NULL,
-- an inline SEQUENCE holding only an aligned NULL) beside one that may fail keep the range check (PDU1, PDU2, PDU3,
-- PDU5); so does a plain NULL beside an aligned one (PDU7).
TEST-CASE DEFINITIONS AUTOMATIC TAGS::= BEGIN

Ref ::= SEQUENCE { x INTEGER (0..5), y BOOLEAN }

PDU1 ::= SEQUENCE { item CHOICE { pad NULL, n INTEGER (0..5) }, tail BOOLEAN }
PDU2 ::= SEQUENCE { item CHOICE { s SEQUENCE (SIZE(1)) OF NULL, n INTEGER (0..5) }, tail BOOLEAN }
PDU3 ::= SEQUENCE { item CHOICE { e SEQUENCE { z NULL }, n INTEGER (0..5) }, tail BOOLEAN }
PDU4 ::= SEQUENCE { item CHOICE { pad NULL, q NULL }, tail BOOLEAN }
PDU5 ::= SEQUENCE { item CHOICE { s SEQUENCE (SIZE(1)) OF NULL, e SEQUENCE { z NULL } }, tail BOOLEAN }
PDU6 ::= SEQUENCE { item CHOICE { n INTEGER (0..5), m INTEGER (0..200), r Ref, k INTEGER (1..6) }, tail BOOLEAN }
PDU7 ::= SEQUENCE { item CHOICE { pad NULL, q NULL }, tail BOOLEAN }

pdu6 PDU6 ::= { item r : { x 5, y FALSE }, tail TRUE }

END

--TCLS PDU1 [] { item [] { pad [align-to-next byte], n [] }, tail [] } PDU2 [] { item [] { s [], n [] }, tail [] } PDU3 [] { item [] { e [] { z [align-to-next byte] }, n [] }, tail [] } PDU4 [] { item [] { pad [align-to-next byte], q [align-to-next byte] }, tail [] } PDU5 [] { item [] { s [], e [] { z [align-to-next byte] } }, tail [] } PDU6 [] { item [] { n [], m [encoding pos-int, size 8], r [], k [align-to-next byte] }, tail [] } PDU7 [] { item [] { pad [align-to-next byte], q [] }, tail [] }
