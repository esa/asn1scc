--RUN_SPARK C_ADA_ONLY (Python, Rust: not needed for this Ada proof shape; types of another module, see 011)
-- Ada validator Posts and loop invariants of nested SEQUENCE OFs name the functions of other packages as the checks do
-- (J1.N_IsConstraintValid), so the index of a quantified fact must not hide a package or any other name: it is chosen
-- fresh against every module and type / value assignment name (modules J1 / J2 here give j1_1 / j2_1). A declaration
-- named Standard (a type here, a value in J2) must not break the module packages either (no Standard. prefix).
-- Not covered: an ENUMERATED item `standard` (master's automatic test units use Standard.<package>, cycle 15h, and do
-- not compile then), module names I1 / I2 (they clash with the loop variables of master's own validators and tests).
-- See 016, 017, 019, 020, 021.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   IMPORTS N FROM J1 M FROM J2;

   Items    ::= SEQUENCE (SIZE(0..3)) OF N
   Nested   ::= SEQUENCE (SIZE(1..2)) OF SEQUENCE (SIZE(0..2)) OF M
   Standard ::= INTEGER (0..7)

   MyPDU ::= SEQUENCE {
      its    Items,
      nst    Nested,
      st     Standard
   }
END

J1 DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   N ::= INTEGER (1..5 | 8..10)
END

J2 DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   IMPORTS N FROM J1;
   M  ::= INTEGER (1..5 | 8..10)
   Ns ::= SEQUENCE (SIZE(0..2)) OF N
   standard INTEGER ::= 3
END

--TCLS     MyPDU[]
