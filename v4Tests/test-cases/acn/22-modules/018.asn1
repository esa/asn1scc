--RUN_SPARK C_ADA_ONLY (Python, Rust: not needed for this Ada proof shape; types of another module, see 011)
-- Ada validator Posts and loop invariants of nested SEQUENCE OFs: the quantifier index of a `for all` (j1, j2) must not
-- hide a package of the same name (modules J1, J2): the facts name every function of another package as
-- Standard.<package>.<name>. (Module names I1 / I2 would clash with the loop variables of master's validators and
-- tests themselves, not with these facts.) See 016, 017, 019.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   IMPORTS N FROM J1 M FROM J2;

   Items  ::= SEQUENCE (SIZE(0..3)) OF N
   Nested ::= SEQUENCE (SIZE(1..2)) OF SEQUENCE (SIZE(0..2)) OF M

   MyPDU ::= SEQUENCE {
      its    Items,
      nst    Nested
   }
END

J1 DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   N ::= INTEGER (1..5 | 8..10)
END

J2 DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   M ::= INTEGER (1..5 | 8..10)
END

--TCLS     MyPDU[]
