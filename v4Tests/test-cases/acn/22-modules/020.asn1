--RUN_SPARK C_ADA_ONLY (Python, Rust: not needed for this Ada proof shape)
-- Ada validator Posts: a PRESENT nested in the WITH COMPONENTS of an OPTIONAL child holds under the child's presence
-- flag (and with the child ALWAYS PRESENT too). Nested WITH COMPONENT: 022. See 016 .. 022.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   K   ::= INTEGER (1..5 | 8..10)
   Rec ::= SEQUENCE { x K OPTIONAL, y K }
   P1  ::= SEQUENCE { r Rec OPTIONAL, f BOOLEAN } (WITH COMPONENTS {..., r (WITH COMPONENTS {..., x PRESENT})})
   P2  ::= SEQUENCE { r Rec OPTIONAL, f BOOLEAN } (WITH COMPONENTS {..., r (WITH COMPONENTS {..., x PRESENT}) PRESENT})

   MyPDU ::= SEQUENCE { fp1 P1, fp2 P2 }
END

--TCLS     MyPDU[]
