--RUN_SPARK C_ADA_ONLY (Python, Rust: not needed for this Ada proof shape; types of another module, see 011)
-- Ada SEQUENCE OF validators state for every element what the element's check implies (Post `for all`, nested, also
-- for an empty list), carried by a quantified loop invariant that is proved but not checked at run time (a block-local
-- Assertion_Policy: checked, it would validate every earlier element again at each iteration); the parent body calls
-- the element's private body in a loop and proves its validity Pre from that Post. A reference site with a fixed SIZE
-- on a variable-size typedef states `Length = N` (its encoder loops to the constant). See 016, 018.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   IMPORTS Num, Name, Lst FROM MOD-B;

   LocalRec ::= SEQUENCE { a Num, n Name }
   LocalLst ::= SEQUENCE (SIZE(0..3)) OF LocalRec
   Flags    ::= SEQUENCE (SIZE(1..4)) OF BOOLEAN

   MyPDU ::= SEQUENCE {
      ll   LocalLst,
      nest SEQUENCE (SIZE(1..2)) OF SEQUENCE (SIZE(0..2)) OF Num,
      lst  Lst,
      fx   Flags (SIZE(2))
   }
END

MOD-B DEFINITIONS AUTOMATIC TAGS ::= BEGIN
   Num  ::= INTEGER (1..5 | 8..10)
   Name ::= IA5String (SIZE(1..4))
   Lst  ::= SEQUENCE (SIZE(1..3)) OF Num
END

--TCLS     MyPDU[]
