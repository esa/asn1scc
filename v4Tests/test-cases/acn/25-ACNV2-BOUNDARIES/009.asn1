-- ACNV2_ONLY KNOWN_FAILURE(Ada,acn-v2,gnata): with -gnata, a corrupted --acn-v2 CONTAINING region longer than the largest encoding of its contents is decoded, while the decoders' contracts bound the position by that maximum (a postcondition / precondition fails in the corruption sweep)
-- BIT STRING variant of 003/004: a size determinant crosses a parameterized
-- CHOICE whose alternatives are BIT STRING CONTAINING regions of different
-- bit lengths, followed by a trailer.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN

Doc ::= SEQUENCE {
    payload Payload,
    trailer INTEGER (0..255)
}

Payload ::= CHOICE {
    value BIT STRING (CONTAINING Value),
    other BIT STRING (CONTAINING Other)
}

Value ::= SEQUENCE {
    number INTEGER (0..255)
}

Other ::= SEQUENCE {
    flag BOOLEAN,
    n    INTEGER (0..7)
}

END

--TCFS   009.acn
