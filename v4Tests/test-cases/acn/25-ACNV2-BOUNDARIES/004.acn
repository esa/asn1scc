TEST-CASE DEFINITIONS ::= BEGIN

Document [] {
    length INTEGER [encoding pos-int, size 8, mapping-function plus],
    kind INTEGER [encoding pos-int, size 8],
    payload <kind, length> []
}

Payload <INTEGER:kind, INTEGER:length> [] {
    value [present-when kind == 1, size length],
    other [present-when kind == 2, size length]
}

Value [] {
    number [encoding pos-int, size 8]
}

END
