-- C_ONLY (Ada: the ACN encoder of the CONTAINING field uses the unrenamed name `body`, a reserved word)
-- A CONTAINING reference to a constrained subtype must validate the subtype.
TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN

X ::= SEQUENCE { field INTEGER (0..1) }
X-P ::= X (WITH COMPONENTS { field (0..0) })
W ::= SEQUENCE { body OCTET STRING (CONTAINING X-P) }

END

--TCFS   020.acn
