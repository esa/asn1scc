<arrsTestFunctionBodies;separator="\n\n">

>>

decodingCaseKind(sBody, sIdentifier) ::= <<
<sBody>
>>

/* Coverage step 11c (T2): a value just outside one constraint. IsConstraintValid and every checked encoder must
   fail with the error code of that constraint. */
emitConstraintViolationTestCase(sFuncName, arrsVars, sModName, sTasName, sAmber, sInitializeTcData, bStatic, sSetInvalidValue, sWhat, sIsValidFunc, sErrCodeModule, sErrCode, arrsEncodeChecks) ::= <<
void <sFuncName>(const TestOutput* output, int *totalErrors)
{
    flag result;
    int errCode = 0;
    <arrsVars; separator="\n">

    output->report_case_begin("<sFuncName>");
    <if(bStatic)>static <endif><sTasName> tc_data;
    <sInitializeTcData>
    /* the automatic test value is valid before the change */
    result = <sIsValidFunc>(<sAmber>tc_data, &errCode) && errCode == 0;
    if (result) {
        /* <sWhat> */
        <sSetInvalidValue>
        errCode = 0;
        result = !<sIsValidFunc>(<sAmber>tc_data, &errCode) && errCode == <sErrCode>;
    }
    <arrsEncodeChecks; separator="\n">
    if (result) {
        output->report_test_case_success("<sTasName>/<sFuncName>", 0);
    } else {
        output->report_failure_begin();
        output->report_failure_message("Test case '<sFuncName>' failed: <sWhat>: not rejected with <sErrCode>, or the starting value was not valid.");
        output->report_failure_message("========================================");
        *totalErrors = (*totalErrors) + 1;
        output->report_failure_end();
    }

    output->report_case_end();
}
>>

constraintViolationEncodeCheck(sEncFunc, sModName, sTasName, sEnc, sAmber, sErrCodeModule, sErrCode) ::= <<
if (result) {
    static byte encBuff_<sEnc>[<sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1]; /* +1 for zerosized types */
    BitStream bitStrm;
    errCode = 0;
    BitStream_Init(&bitStrm, encBuff_<sEnc>, <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING);
    result = !<sEncFunc>(<sAmber>tc_data, &bitStrm, &errCode, TRUE) && errCode == <sErrCode>;
}
>>

/* Coverage step 12d: an invalid CHOICE selector or ENUMERATED value behind a reference or in a SEQUENCE OF element.
   The unchecked encoder must fail too, with any error code: the arm that rejects the value depends on the encoding
   (the parent's inline ENUMERATED map, a determinant switch, the CHOICE's own switch). */
constraintViolationUncheckedEncodeCheck(sEncFunc, sModName, sTasName, sEnc, sAmber) ::= <<
if (result) {
    static byte encBuffUnchecked_<sEnc>[<sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING + 1]; /* +1 for zerosized types */
    BitStream bitStrm;
    errCode = 0;
    BitStream_Init(&bitStrm, encBuffUnchecked_<sEnc>, <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING);
    result = !<sEncFunc>(<sAmber>tc_data, &bitStrm, &errCode, FALSE) && errCode != 0;
}
>>

/* Coverage step 11c: character nIndex (0-based) of a string set to the code nChar (0 ends the string there). */
constraintViolationStringChar(sStr, nIndex, nChar) ::= <<
<sStr>[<nIndex>] = (char)<nChar>;
>>
