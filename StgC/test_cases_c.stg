#ifndef GENERATED_ASN1SCC_<sModNameUpperCase>
#define GENERATED_ASN1SCC_<sModNameUpperCase>
/*
Code automatically generated by asn1scc tool
*/
#include "asn1crt.h"
#include "<sModName>.h"

#ifdef  __cplusplus
extern "C" {
#endif


<arrsTestFunctions:{tas|<tas>}; separator="\n\n">



#ifdef  __cplusplus
}
#endif

#endif

>>


PrintAutomaticTestCasesBodyFile(sModName, sTetscaseSpecFileName, arrsIncludedModules, arrsTasNames, arrsTypeAssignments, bXer) ::= <<
/*
Code automatically generated by asn1scc tool
*/

#include \<string.h>
#include \<math.h>
#include \<limits.h>
#include \<stdio.h>
#include "asn1crt.h"
#include "<sTetscaseSpecFileName>"

<arrsIncludedModules: {inc|#include "<inc>.h"}; separator="\n">

<arrsTypeAssignments:{tas|<tas>}; separator="\n">

>>





/* Encode Decode start*/





Codec_Encode(sModName, sFuncName, sVal) ::= <<
// Encode value
ret = <sFuncName>(<sVal>, &bitStrm, pErrCode, TRUE);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 1;
ret = *pErrCode == 0; /* a function that succeeds must not report an error */
/* Encode the valid value again without the constraint check (bCheckConstraints = FALSE):
   the output must be identical. Compare only valid checked encodes, retaining their stream
   for the round trip. */
if (ret) {
    static byte uncheckedBuff[sizeof encBuff];
    BitStream uncheckedStrm;
    int uncheckedError = 0;
    BitStream_Init(&uncheckedStrm, uncheckedBuff, bitStrm.count);
    ret = <sFuncName>(<sVal>, &uncheckedStrm, &uncheckedError, FALSE);
    ret = ret && uncheckedError == 0 &&
        uncheckedStrm.currentByte == bitStrm.currentByte &&
        uncheckedStrm.currentBit == bitStrm.currentBit;
    if (ret) {
        ret = memcmp(encBuff, uncheckedBuff, (size_t)bitStrm.currentByte) == 0;
        if (ret && bitStrm.currentBit != 0) {
            unsigned int mask = 0xFFu \<\< (8 - bitStrm.currentBit);
            ret = (encBuff[bitStrm.currentByte] & mask) ==
                  (uncheckedBuff[bitStrm.currentByte] & mask);
        }
    }
    *pErrCode = ret ? 0 : 5;
}
>>

Codec_Encode_XER(sModName, sFuncName, sVal, sTasName) ::= <<
// Encode value
ret = <sFuncName>(<sVal>, &bitStrm, pErrCode, TRUE);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 1;
>>

Codec_Decode(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
#ifdef ASN1SCC_DECODE_ACTUAL_LENGTH
{
    long encLenBytes = BitStream_GetLength(&bitStrm);
    BitStream_AttachBuffer(&bitStrm, encBuff, (int)encLenBytes);
}
#else
BitStream_AttachBuffer(&bitStrm, encBuff, <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING);
#endif
// Decode value
ret = <sFuncName>(<sAmber>decodedPDU, &bitStrm, pErrCode);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 2;
ret = *pErrCode == 0; /* a function that succeeds must not report an error */
>>

/* 'size deduced' PDU: the decoder derives element counts from the end of the
   bitstream view, so it must be attached to exactly the encoded PDU length */
Codec_Decode_exact_length(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
{
	long encLenBytes = BitStream_GetLength(&bitStrm);
	BitStream_AttachBuffer(&bitStrm, encBuff, (int)encLenBytes);
}
// Decode value
ret = <sFuncName>(<sAmber>decodedPDU, &bitStrm, pErrCode);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 2;
ret = *pErrCode == 0; /* a function that succeeds must not report an error */
>>

Codec_Decode_XER(sModName, sFuncName, sTasName, sEnc, sAmber) ::= <<
ByteStream_AttachBuffer(&bitStrm, encBuff, <sTasName>_REQUIRED_BYTES_FOR_<sEnc>ENCODING);
// Decode value
ret = <sFuncName>(<sAmber>decodedPDU, &bitStrm, pErrCode);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 2;
ret = *pErrCode == 0; /* a function that succeeds must not report an error */
>>

Codec_validate_output(sModName, sFuncName, sAmber) ::= <<
// validate decoded data
ret = <sFuncName>(<sAmber>decodedPDU, pErrCode);
*pErrCode = (ret && *pErrCode ==0) ? 0 : 3;
ret = *pErrCode == 0; /* a function that succeeds must not report an error */
>>

Codec_compare_input_with_output(sModName, sFuncName, sVal, sAmber) ::= <<
ret = <sFuncName>(<sVal>, <sAmber>decodedPDU);
*pErrCode = ret ? 0 : 4;
>>

/* Decode fault sweep of the uPER / ACN automatic tests (coverage step 10): after a successful round trip,
   truncated and corrupted copies of the encoded value are decoded. Emitted once per *_auto_tcs.c file. */
Codec_DecodeSweep_helper(nBudget) ::= <<
#include \<stdlib.h\>

/* Decode fault sweep of the automatic tests (asn1scc -atc, uPER and ACN). After a successful round trip,
   copies of the encoded value are decoded:
   - truncation: the first k bytes, from a buffer of exactly k bytes (a read past the view is an out-of-bounds
     read); the decoder must fail with a nonzero error code ('size deduced' PDUs: or succeed with a valid value);
   - corruption: byte i set to 0x00, then to 0xFF (restored after each decode); the decoder must fail with a
     nonzero error code or succeed with a valid value.
   At most ASN1SCC_SWEEP_POSITIONS positions at each end of the encoding, and about ASN1SCC_SWEEP_BUDGET
   decoded bytes per sweep (asn1scc -atcSweepBudget); at least 2 positions at each end. */
#ifndef ASN1SCC_SWEEP_POSITIONS
#define ASN1SCC_SWEEP_POSITIONS 128
#endif
#ifndef ASN1SCC_SWEEP_BUDGET
#define ASN1SCC_SWEEP_BUDGET <nBudget>LL
#endif

typedef flag (*asn1scc_sweep_decoder)(void* pDecoded, BitStream* pBitStrm, int* pErrCode, flag* pValid);

/* Positions 0 .. nBytes-1 to try: the head first, then the tail. The cost of a position is the number of bytes
   the decoder reads: the position itself (truncation, bFullCost FALSE) or nBytes (corruption, bFullCost TRUE). */
static int asn1scc_sweep_positions(long* positions, long nBytes, flag bFullCost)
{
    int nPositions = 0;
    int side;
    long lastHead = -1;
    for (side = 0; side \< 2; side++) {
        long long spent = 0;
        int count = 0;
        long k = side == 0 ? 0 : nBytes - 1;
        while (side == 0 ? k \< nBytes : k \> lastHead) {
            if (count \>= ASN1SCC_SWEEP_POSITIONS || (count \>= 2 && spent \>= ASN1SCC_SWEEP_BUDGET / 2)) {
                break;
            }
            positions[nPositions++] = k;
            count++;
            spent += bFullCost ? nBytes : k;
            if (side == 0) {
                lastHead = k;
                k++;
            } else {
                k--;
            }
        }
    }
    return nPositions;
}

/* Returns 0, 6 (a truncated copy was accepted, or rejected without an error code) or 7 (a corrupted copy was
   accepted with an invalid value, or rejected without an error code); stops at the first violation. */
static int asn1scc_decode_fault_sweep(const char* sTestName, byte* encBuff, long nBytes, void* pDecoded,
                                      asn1scc_sweep_decoder decode, flag bTruncate, flag bDeduced)
{
    long positions[2 * ASN1SCC_SWEEP_POSITIONS];
    int nPositions;
    int j;
    int pattern;
    int errCode;
    flag ok;
    flag valid;
    BitStream sweepStrm;

    if (bTruncate) {
        nPositions = asn1scc_sweep_positions(positions, nBytes, FALSE);
        for (j = 0; j \< nPositions; j++) {
            long k = positions[j];
            byte* prefix = (byte*)malloc((size_t)(k \> 0 ? k : 1));
            if (prefix == NULL) {
                return 0;
            }
            memcpy(prefix, encBuff, (size_t)k);
            BitStream_AttachBuffer(&sweepStrm, prefix, k);
            errCode = 0;
            valid = TRUE;
            ok = decode(pDecoded, &sweepStrm, &errCode, &valid);
            free(prefix);
            if (ok ? !(bDeduced && errCode == 0 && valid) : errCode == 0) {
                printf("%s: decoding the first %ld of %ld bytes returned %s with error code %d%s\n", sTestName, k, nBytes,
                       ok ? "TRUE" : "FALSE", errCode, ok && !valid ? " and an invalid value" : "");
                return 6;
            }
        }
    }
    nPositions = asn1scc_sweep_positions(positions, nBytes, TRUE);
    for (j = 0; j \< nPositions; j++) {
        long i = positions[j];
        for (pattern = 0x00; pattern \<= 0xFF; pattern += 0xFF) {
            byte saved = encBuff[i];
            if (saved == (byte)pattern) {
                continue;
            }
            encBuff[i] = (byte)pattern;
            BitStream_AttachBuffer(&sweepStrm, encBuff, nBytes);
            errCode = 0;
            valid = TRUE;
            ok = decode(pDecoded, &sweepStrm, &errCode, &valid);
            encBuff[i] = saved;
            if (ok ? (errCode != 0 || !valid) : errCode == 0) {
                printf("%s: decoding with byte %ld of %ld set to 0x%02X returned %s with error code %d%s\n", sTestName, i, nBytes,
                       pattern, ok ? "TRUE" : "FALSE", errCode, ok && !valid ? " and an invalid value" : "");
                return 7;
            }
        }
    }
    return 0;
}

>>

/* Decoder of one automatic test function for asn1scc_decode_fault_sweep: decodes into the function's
   decodedPDU and reports whether a decoded value is valid. */
Codec_DecodeSweep_adapter(sModName, sFuncName, sDecFuncName, sTasName, sAmber, soIsValidFunc) ::= <<
static flag <sFuncName>_sweep_decoder(void* pDecoded, BitStream* pBitStrm, int* pErrCode, flag* pValid)
{
    int validErrCode = 0;
    flag ok = <sDecFuncName>(<sAmber>(*(<sTasName>*)pDecoded), pBitStrm, pErrCode);
    <if(soIsValidFunc)>
    *pValid = !ok || <soIsValidFunc>(<sAmber>(*(<sTasName>*)pDecoded), &validErrCode);
    <else>
    *pValid = TRUE;
    (void)validErrCode;
    <endif>
    return ok;
}
>>

Codec_DecodeSweep(sModName, sFuncName, sDecFuncName, sTasName, sEnc, sAmber, soIsValidFunc, bTruncate, bDeduced, nBudget) ::= <<
// Decode truncated and corrupted copies of the encoded value
*pErrCode = asn1scc_decode_fault_sweep("<sFuncName>", encBuff, BitStream_GetLength(&bitStrm), &decodedPDU, <sFuncName>_sweep_decoder, <if(bTruncate)>TRUE<else>FALSE<endif>, <if(bDeduced)>TRUE<else>FALSE<endif>);
ret = *pErrCode == 0;
>>

Codec_write_CharstreamToFile() ::= <<
char buf[1024];
strcpy(buf, filename);
FILE* fp = fopen(strcat(buf,".xml"), "w");
fwrite(bitStrm.buf, 1, bitStrm.currentByte, fp);
fclose(fp);
>>

Codec_write_bitstreamToFile() ::= <<
char buf[1024];
strcpy(buf, filename);
FILE* fp = fopen(strcat(buf,".dat"), "wb");
fwrite(bitStrm.buf, 1, bitStrm.currentBit > 0 ? bitStrm.currentByte + 1 : bitStrm.currentByte, fp);
fclose(fp);
>>

